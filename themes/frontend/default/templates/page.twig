{% extends 'base.twig' %}

{% block title %}{{ entry_data.title|default('Seite') }} – {{ site_name|default('Chamy CMS') }}{% endblock %}
{% block body_class %}page-single{% endblock %}

{% block body %}
<section class="page-content">
    <div class="container">
        <h1>{{ entry_data.title }}</h1>
        <div class="page-meta">
            {{ t('system.published')|default('Veröffentlicht') }} {{ entry.published_at|default(entry.created_at)|date('d.m.Y') }}
        </div>
        <div class="body-text">
            {{ entry_data.body|raw }}
        </div>
    </div>
</section>
{% endblock %}
