<!DOCTYPE html>
<html lang="{{ app_locale|default('de') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ site_name|default('Chamy CMS') }}{% endblock %}</title>
    {% if seo_description is defined %}<meta name="description" content="{{ seo_description }}">{% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ theme_asset('css/frontend.css') }}">
    {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">

<header class="site-header">
    <div class="container">
        <a href="/" class="site-logo"><span>{{ site_name|default('Chamy') }}</span></a>
        <nav class="site-nav">
            <a href="/" class="{{ current_route == 'home' ? 'active' : '' }}">Start</a>
            <a href="/seite/features" class="{{ current_route == 'features' ? 'active' : '' }}">Features</a>
            <a href="/seite/pricing" class="{{ current_route == 'pricing' ? 'active' : '' }}">Pricing</a>
            <a href="/artikel" class="{{ current_route == 'articles' ? 'active' : '' }}">Blog</a>
            <a href="/seite/about" class="{{ current_route == 'about' ? 'active' : '' }}">Über uns</a>
            <a href="#" class="nav-cta">Demo starten</a>
        </nav>
    </div>
</header>

{% block body %}{% endblock %}

<footer class="site-footer">
    <div class="container">
        &copy; {{ 'now'|date('Y') }} {{ site_name|default('Chamy CMS') }} &mdash; Powered by <a href="#">Chamy</a>
    </div>
</footer>

<script src="{{ theme_asset('js/frontend.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
