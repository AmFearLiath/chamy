{% extends 'base.twig' %}

{% block title %}{{ t('modules.marketplace_title')|default('Mod-Marktplatz') }} – Chamy CMS{% endblock %}

{% block breadcrumb %}
    <a href="/admin">{{ t('admin.dashboard')|default('Dashboard') }}</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/admin/modules">{{ t('admin.modules')|default('Module') }}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{{ t('modules.marketplace_tab')|default('Marketplace') }}</span>
{% endblock %}

{% block content %}
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">{{ t('modules.marketplace_title')|default('Mod-Marktplatz') }}</h1>
        <span class="page-badge">{{ marketplace.counts.all }} {{ t('modules.available')|default('verfügbar') }}</span>
    </div>
    <div class="page-header-right">
        <a href="/admin/modules" class="btn btn-ghost">{{ t('modules.back_to_dashboard')|default('Zurück zum Dashboard') }}</a>
        <a href="/admin/modules/manager" class="btn btn-secondary">{{ t('modules.manager_tab')|default('Manager') }}</a>
    </div>
</div>

{# ── Filter Bar ── #}
<form method="get" action="/admin/modules/marketplace" class="theme-filter-bar card">
    <div class="card-body theme-filter-grid mod-filter-grid">
        <div class="form-group" style="margin-bottom:0;">
            <label class="form-label">{{ t('modules.search')|default('Suche') }}</label>
            <input type="text" name="q" class="form-control" value="{{ marketplace.filters.q }}" placeholder="{{ t('modules.search_placeholder')|default('Name, Tags, Autor …') }}">
        </div>
        <div class="form-group" style="margin-bottom:0;">
            <label class="form-label">{{ t('modules.category')|default('Kategorie') }}</label>
            <select name="category" class="form-control">
                <option value="all" {{ marketplace.filters.category == 'all' ? 'selected' : '' }}>{{ t('modules.all')|default('Alle') }} ({{ marketplace.counts.all }})</option>
                {% for cat, count in marketplace.categories %}
                <option value="{{ cat }}" {{ marketplace.filters.category == cat ? 'selected' : '' }}>{{ category_labels[cat]|default(cat|capitalize) }} ({{ count }})</option>
                {% endfor %}
            </select>
        </div>
        <div class="form-group" style="margin-bottom:0;">
            <label class="form-label">{{ t('modules.price')|default('Preis') }}</label>
            <select name="pricing" class="form-control">
                <option value="all" {{ marketplace.filters.pricing == 'all' ? 'selected' : '' }}>{{ t('modules.all')|default('Alle') }}</option>
                <option value="free" {{ marketplace.filters.pricing == 'free' ? 'selected' : '' }}>{{ t('modules.free')|default('Kostenlos') }} ({{ marketplace.counts.free }})</option>
                <option value="paid" {{ marketplace.filters.pricing == 'paid' ? 'selected' : '' }}>{{ t('modules.paid')|default('Bezahlt') }} ({{ marketplace.counts.paid }})</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom:0;">
            <label class="form-label">{{ t('modules.sort')|default('Sortierung') }}</label>
            <select name="sort" class="form-control">
                <option value="popular" {{ marketplace.filters.sort == 'popular' ? 'selected' : '' }}>{{ t('modules.sort_popular')|default('Popularität') }}</option>
                <option value="rating" {{ marketplace.filters.sort == 'rating' ? 'selected' : '' }}>{{ t('modules.sort_rating')|default('Bewertung') }}</option>
                <option value="newest" {{ marketplace.filters.sort == 'newest' ? 'selected' : '' }}>{{ t('modules.sort_newest')|default('Neueste') }}</option>
                <option value="price_asc" {{ marketplace.filters.sort == 'price_asc' ? 'selected' : '' }}>{{ t('modules.sort_price_asc')|default('Preis aufsteigend') }}</option>
                <option value="price_desc" {{ marketplace.filters.sort == 'price_desc' ? 'selected' : '' }}>{{ t('modules.sort_price_desc')|default('Preis absteigend') }}</option>
                <option value="name" {{ marketplace.filters.sort == 'name' ? 'selected' : '' }}>{{ t('modules.sort_name')|default('Name') }}</option>
            </select>
        </div>
        <div class="theme-filter-actions">
            <button class="btn btn-primary" type="submit">{{ t('modules.filter')|default('Filtern') }}</button>
        </div>
    </div>
</form>

{# ── Marketplace Grid ── #}
<div class="theme-card-grid mod-card-grid" style="margin-top:1rem;">
    {% for item in marketplace.items %}
    <article class="theme-card mod-card">
        <div class="theme-preview-block preview-swatch-{{ (loop.index0 % 6) + 1 }}">
            <span>{{ category_labels[item.category]|default(item.category|capitalize) }}</span>
        </div>
        <div class="theme-card-body">
            <h3>{{ item.name }}</h3>
            <p class="text-muted">{{ item.description }}</p>

            {# Quick Info #}
            <div class="theme-meta-line">
                <span class="badge {{ item.pricing == 'free' ? 'badge-published' : 'badge-review' }}">{{ item.pricing == 'free' ? t('modules.free')|default('Kostenlos') : item.price ~ ' ' ~ item.currency }}</span>
                <span class="text-muted">v{{ item.version }}</span>
                <span class="text-muted">{{ item.author }}</span>
                <span class="text-muted">↓ {{ item.downloads }}</span>
                <span class="text-muted">★ {{ item.rating }}</span>
            </div>

            {# Tags #}
            <div class="theme-tag-list">
                {% for tag in item.tags %}
                <span>{{ tag }}</span>
                {% endfor %}
            </div>

            {# Features #}
            <div class="theme-manager-items">
                {% for feature in item.features %}
                <span>{{ feature }}</span>
                {% endfor %}
            </div>

            {# Actions #}
            <div class="theme-card-actions">
                <a href="/admin/modules/marketplace/{{ item.id }}" class="btn btn-sm btn-secondary">{{ t('modules.preview_details')|default('Details') }}</a>
                <button class="btn btn-sm btn-primary" {{ not can_manage_modules ? 'disabled' : '' }}>{{ t('modules.install')|default('Installieren') }}</button>
            </div>
        </div>
    </article>
    {% else %}
    <div class="card"><div class="card-body text-muted">{{ t('modules.no_marketplace_filtered')|default('Keine Module für die aktuellen Filter gefunden.') }}</div></div>
    {% endfor %}
</div>
{% endblock %}
