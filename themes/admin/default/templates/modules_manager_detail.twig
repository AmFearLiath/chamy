{% extends 'base.twig' %}

{% block title %}{{ mod.name|default('Modul') }} – {{ t('modules.manager_tab')|default('Manager') }} – Chamy CMS{% endblock %}

{% block breadcrumb %}
    <a href="/admin">{{ t('admin.dashboard')|default('Dashboard') }}</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/admin/modules">{{ t('admin.modules')|default('Module') }}</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/admin/modules/manager">{{ t('modules.manager_tab')|default('Manager') }}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{{ mod.name|default(mod.id) }}</span>
{% endblock %}

{% block content %}
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">{{ mod.name|default(mod.id) }}</h1>
        <span class="page-badge">{{ mod._is_active ? t('modules.active')|default('Aktiv') : t('modules.inactive')|default('Inaktiv') }}</span>
    </div>
    <div class="page-header-right">
        <a href="/admin/modules/manager" class="btn btn-ghost">{{ t('modules.back_to_manager')|default('Zurück zum Manager') }}</a>
        {% if mod._has_config %}
        <a href="/admin/modules/config/{{ mod.id }}" class="btn btn-secondary">{{ t('modules.configure')|default('Konfigurieren') }}</a>
        {% endif %}
        {% if can_manage_modules %}
        <form action="{{ route('admin.modules.toggle', {'id': mod.id}) }}" method="post" style="display:inline-block;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <button type="submit" class="btn {{ mod._is_active ? 'btn-ghost' : 'btn-primary' }}" data-confirm="{{ mod._is_active ? 'Modul deaktivieren?' : 'Modul aktivieren?' }}">{{ mod._is_active ? t('modules.deactivate')|default('Deaktivieren') : t('modules.activate')|default('Aktivieren') }}</button>
        </form>
        {% endif %}
    </div>
</div>

<div class="mod-detail-layout">
    {# ── Main Info ── #}
    <section class="card">
        <div class="card-header">
            <h3 class="card-title">{{ t('modules.overview')|default('Übersicht') }}</h3>
        </div>
        <div class="card-body">
            <p>{{ mod.description|default(t('modules.no_description')|default('Keine Beschreibung vorhanden.')) }}</p>

            <h4 style="margin-top:1.25rem;">{{ t('modules.manifest')|default('Manifest-Daten') }}</h4>
            <dl class="mod-info-list">
                <dt>ID</dt>
                <dd><code>{{ mod.id }}</code></dd>

                <dt>{{ t('modules.version')|default('Version') }}</dt>
                <dd>v{{ mod.version|default('?') }}</dd>

                <dt>{{ t('modules.author')|default('Autor') }}</dt>
                <dd>{{ mod.author|default('Unbekannt') }}</dd>

                {% if mod.license is defined %}
                <dt>{{ t('modules.license')|default('Lizenz') }}</dt>
                <dd>{{ mod.license }}</dd>
                {% endif %}

                <dt>{{ t('modules.entry')|default('Einstiegspunkt') }}</dt>
                <dd><code>{{ mod.entry|default('module.php') }}</code></dd>

                {% if mod.hooks is defined and mod.hooks is iterable %}
                <dt>{{ t('modules.hooks')|default('Hooks') }}</dt>
                <dd>
                    <div class="theme-tag-list">
                        {% for hook in mod.hooks %}
                        <span>{{ hook }}</span>
                        {% endfor %}
                    </div>
                </dd>
                {% endif %}

                {% if mod.requires is defined and mod.requires is iterable %}
                <dt>{{ t('modules.requirements')|default('Voraussetzungen') }}</dt>
                <dd>
                    {% for pkg, ver in mod.requires %}
                    <code>{{ pkg }}</code> {{ ver }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </dd>
                {% endif %}
            </dl>

            {% if readme is not empty %}
            <h4 style="margin-top:1.5rem;">README</h4>
            <div class="mod-readme-block">
                <pre>{{ readme }}</pre>
            </div>
            {% endif %}
        </div>
    </section>

    {# ── Sidebar ── #}
    <aside class="mod-detail-sidebar">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ t('modules.status')|default('Status') }}</h3>
            </div>
            <div class="card-body">
                <div class="mod-status-indicator {{ mod._is_active ? 'mod-status-active' : 'mod-status-inactive' }}">
                    <span class="mod-status-dot"></span>
                    <span>{{ mod._is_active ? t('modules.status_active_text')|default('Modul ist aktiv und geladen') : t('modules.status_inactive_text')|default('Modul ist deaktiviert') }}</span>
                </div>

                <dl class="mod-info-list" style="margin-top:1rem;">
                    <dt>{{ t('modules.path')|default('Pfad') }}</dt>
                    <dd class="text-muted" style="font-size:.8rem;word-break:break-all;"><code>{{ mod._path }}</code></dd>

                    <dt>{{ t('modules.has_config')|default('Konfiguration') }}</dt>
                    <dd>{{ mod._has_config ? t('modules.config_available')|default('config.json vorhanden') : t('modules.no_config')|default('Keine Konfigurationsdatei') }}</dd>

                    {% if mod.languages is defined %}
                    <dt>{{ t('modules.languages')|default('Sprachen') }}</dt>
                    <dd>{{ mod.languages }}</dd>
                    {% endif %}

                    {% if mod.content_types is defined %}
                    <dt>{{ t('modules.content_types')|default('Content-Types') }}</dt>
                    <dd>{{ mod.content_types }}</dd>
                    {% endif %}
                </dl>
            </div>
        </div>

        {% if can_manage_modules %}
        <div class="card" style="margin-top:1rem;">
            <div class="card-header">
                <h3 class="card-title">{{ t('modules.actions')|default('Aktionen') }}</h3>
            </div>
            <div class="card-body">
                <div class="mod-action-stack">
                    <form action="{{ route('admin.modules.toggle', {'id': mod.id}) }}" method="post">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <button type="submit" class="btn btn-block {{ mod._is_active ? 'btn-ghost' : 'btn-primary' }}" data-confirm="{{ mod._is_active ? 'Modul deaktivieren?' : 'Modul aktivieren?' }}">{{ mod._is_active ? t('modules.deactivate')|default('Deaktivieren') : t('modules.activate')|default('Aktivieren') }}</button>
                    </form>

                    {% if mod._has_config %}
                    <a href="/admin/modules/config/{{ mod.id }}" class="btn btn-block btn-secondary">{{ t('modules.configure')|default('Konfigurieren') }}</a>
                    {% endif %}

                    <form action="{{ route('admin.modules.uninstall', {'id': mod.id}) }}" method="post">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <button type="submit" class="btn btn-block btn-danger" data-confirm-double="1" data-confirm="{{ t('modules.confirm_uninstall_step1')|default('Modul wirklich deinstallieren?') }}" data-confirm-second="{{ t('modules.confirm_uninstall_step2')|default('Diese Aktion kann nicht rückgängig gemacht werden.') }}">{{ t('modules.uninstall')|default('Deinstallieren') }}</button>
                    </form>
                </div>
            </div>
        </div>
        {% endif %}
    </aside>
</div>
{% endblock %}
