{% extends "base.twig" %}

{% block title %}{{ location.label }} – {{ t('menu.title')|default('Menüverwaltung') }}{% endblock %}

{% block breadcrumb %}
    <a href="/admin">{{ t('admin.dashboard')|default('Dashboard') }}</a>
    <span class="breadcrumb-sep">/</span>
    <a href="/admin/menus">{{ t('menu.title')|default('Menüs') }}</a>
    <span class="breadcrumb-sep">/</span>
    <span>{{ location.label }}</span>
{% endblock %}

{% block content %}
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">{{ location.label }}</h1>
        <p class="page-desc">{{ location.description|default('') }} <span class="badge badge-muted">{{ location.key }}</span></p>
    </div>
    <div class="page-header-actions">
        <a href="/admin/menus/locations/{{ location.id }}/categories/create" class="btn btn-outline btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
            {{ t('menu.category_create')|default('Kategorie') }}
        </a>
        <a href="/admin/menus/locations/{{ location.id }}/items/create" class="btn btn-primary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            {{ t('menu.item_create')|default('Eintrag erstellen') }}
        </a>
        <a href="/admin/menus" class="btn btn-outline btn-sm">{{ t('admin.back')|default('Zurück') }}</a>
    </div>
</div>

{% for msg in flash_messages.success|default([]) %}
<div class="alert alert-success">{{ msg }}</div>
{% endfor %}
{% for msg in flash_messages.error|default([]) %}
<div class="alert alert-error">{{ msg }}</div>
{% endfor %}

<div class="menu-editor-layout">
    {# ── Left: Tree View ── #}
    <div class="menu-tree-panel">
        <div class="menu-tree-header">
            <h3>{{ t('menu.structure')|default('Struktur') }}</h3>
            <button type="button" class="btn btn-sm btn-outline" id="menuSaveOrder" disabled>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                {{ t('menu.save_order')|default('Reihenfolge speichern') }}
            </button>
        </div>

        <div id="menuTree" class="menu-tree" data-location-id="{{ location.id }}">
            {% for group in tree %}
            <div class="menu-tree-category" data-category-id="{{ group.category.id }}">
                <div class="menu-tree-category-header">
                    <span class="menu-tree-category-label">{{ group.category.display_label }}</span>
                    <div class="menu-tree-category-actions">
                        <a href="/admin/menus/categories/{{ group.category.id }}/edit" class="btn-icon" title="{{ t('admin.edit')|default('Bearbeiten') }}">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </a>
                    </div>
                </div>
                <div class="menu-tree-items sortable-group" data-category-id="{{ group.category.id }}">
                    {% for item in group.items %}
                        {{ _self.render_tree_item(item) }}
                    {% endfor %}
                    {% if not group.items %}
                    <div class="menu-tree-empty">{{ t('menu.no_items')|default('Keine Einträge') }}</div>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    {# ── Right: Inspector Panel ── #}
    <div class="menu-inspector-panel" id="menuInspector">
        <div class="menu-inspector-empty">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.3"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <p>{{ t('menu.select_item')|default('Wähle einen Eintrag um Details anzuzeigen') }}</p>
        </div>
        <div class="menu-inspector-content" style="display:none">
            <h3 class="menu-inspector-title" id="inspectorTitle"></h3>
            <div class="menu-inspector-meta" id="inspectorMeta"></div>
            <div class="menu-inspector-actions" id="inspectorActions"></div>
        </div>
    </div>
</div>

{# Recursive macro for tree items #}
{% macro render_tree_item(item) %}
<div class="menu-tree-item sortable-item{{ item.is_hidden ? ' is-hidden' : '' }}{{ item.is_manual ? ' is-manual' : '' }}{{ not item.is_active ? ' is-inactive' : '' }}"
     data-id="{{ item.id }}"
     data-key="{{ item.key }}"
     data-source="{{ item.source }}"
     data-target-type="{{ item.target_type }}"
     data-target-value="{{ item.target_value }}"
     data-parent-id="{{ item.parent_id }}"
     data-category-id="{{ item.category_id }}"
     draggable="true">
    <div class="menu-tree-item-handle">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.4"><circle cx="9" cy="5" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="19" r="1"/></svg>
    </div>
    <div class="menu-tree-item-content" data-inspect="{{ item.id }}">
        {% if item.icon %}
        <span class="menu-tree-item-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </span>
        {% endif %}
        <span class="menu-tree-item-label">{{ item.translated_label|default(item.key) }}</span>
        <div class="menu-tree-item-badges">
            {% if item.source == 'core' %}
                <span class="badge badge-source badge-core">Core</span>
            {% elseif item.source == 'module' %}
                <span class="badge badge-source badge-module">{{ item.source_ref }}</span>
            {% elseif item.source == 'theme' %}
                <span class="badge badge-source badge-theme">Theme</span>
            {% elseif item.source == 'manual' %}
                <span class="badge badge-source badge-manual">{{ t('menu.manual')|default('Manuell') }}</span>
            {% elseif item.source == 'import' %}
                <span class="badge badge-source badge-import">Import</span>
            {% endif %}
            {% if item.is_hidden %}
                <span class="badge badge-warn">{{ t('menu.hidden')|default('Versteckt') }}</span>
            {% endif %}
            {% if item.is_manual and item.source != 'manual' %}
                <span class="badge badge-info">{{ t('menu.overridden')|default('Angepasst') }}</span>
            {% endif %}
            {% if item.target_type == 'separator' %}
                <span class="badge badge-muted">—</span>
            {% endif %}
        </div>
    </div>
    <div class="menu-tree-item-actions">
        <a href="/admin/menus/items/{{ item.id }}/edit" class="btn-icon" title="{{ t('admin.edit')|default('Bearbeiten') }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </a>
    </div>
    {% if item.children is defined and item.children|length > 0 %}
    <div class="menu-tree-children sortable-group" data-category-id="{{ item.category_id }}">
        {% for child in item.children %}
            {{ _self.render_tree_item(child) }}
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endmacro %}

{% endblock %}

{% block head %}
<style>
/* ── Menu Editor Layout ── */
.menu-editor-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 20px;
    margin-top: 16px;
    min-height: 500px;
}
@media (max-width: 1024px) {
    .menu-editor-layout { grid-template-columns: 1fr; }
}

/* ── Tree Panel ── */
.menu-tree-panel {
    background: var(--card-bg, #151a1e);
    border: 1px solid var(--card-border, rgba(255,255,255,0.06));
    border-radius: var(--card-radius, 12px);
    overflow: hidden;
}
.menu-tree-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--card-border, rgba(255,255,255,0.06));
}
.menu-tree-header h3 { margin: 0; font-size: 15px; }

/* ── Category ── */
.menu-tree-category {
    border-bottom: 1px solid var(--surface-200, rgba(255,255,255,0.04));
}
.menu-tree-category:last-child { border-bottom: none; }
.menu-tree-category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    background: var(--surface-100, rgba(255,255,255,0.02));
}
.menu-tree-category-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted, #7a8a9e);
}
.menu-tree-category-actions { display: flex; gap: 4px; }

/* ── Tree Items ── */
.menu-tree-items {
    min-height: 32px;
    padding: 4px 0;
}
.menu-tree-empty {
    padding: 12px 20px;
    font-size: 13px;
    color: var(--text-muted, #7a8a9e);
    font-style: italic;
}

.menu-tree-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    padding: 6px 20px 6px 8px;
    cursor: default;
    transition: background 0.15s;
    border-left: 3px solid transparent;
    position: relative;
}
.menu-tree-item:hover { background: var(--surface-100, rgba(255,255,255,0.03)); }
.menu-tree-item.is-hidden { opacity: 0.45; }
.menu-tree-item.is-inactive { opacity: 0.35; text-decoration: line-through; }
.menu-tree-item.is-manual { border-left-color: var(--neon-magenta, #ff2d95); }
.menu-tree-item.selected {
    background: var(--surface-200, rgba(0,240,255,0.06));
    border-left-color: var(--neon-cyan, #00f0ff);
}

.menu-tree-item-handle {
    cursor: grab;
    padding: 4px 6px;
    opacity: 0.4;
    flex-shrink: 0;
}
.menu-tree-item-handle:active { cursor: grabbing; }

.menu-tree-item-content {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    cursor: pointer;
    padding: 4px 0;
}
.menu-tree-item-icon { flex-shrink: 0; color: var(--text-muted); }
.menu-tree-item-label {
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.menu-tree-item-badges { display: flex; gap: 4px; flex-shrink: 0; }
.menu-tree-item-actions { display: flex; gap: 2px; opacity: 0; transition: opacity 0.15s; flex-shrink: 0; }
.menu-tree-item:hover .menu-tree-item-actions { opacity: 1; }

/* ── Children (nested) ── */
.menu-tree-children {
    padding-left: 24px;
    width: 100%;
    min-height: 4px;
}

/* ── Source badges ── */
.badge-source { font-size: 10px; padding: 1px 6px; border-radius: 10px; }
.badge-core   { background: var(--neon-cyan, #00f0ff); color: #000; }
.badge-module { background: var(--neon-violet, #8b5cf6); color: #fff; }
.badge-theme  { background: var(--neon-green, #10b981); color: #000; }
.badge-manual { background: var(--neon-magenta, #ff2d95); color: #fff; }
.badge-import { background: var(--neon-orange, #f59e0b); color: #000; }

/* ── Drag & Drop ── */
.menu-tree-item.dragging { opacity: 0.3; }
.menu-tree-item.drag-over { box-shadow: 0 2px 0 0 var(--neon-cyan, #00f0ff); }
.sortable-group.drag-over-group { background: rgba(0,240,255,0.04); border-radius: 6px; }

/* ── Inspector Panel ── */
.menu-inspector-panel {
    background: var(--card-bg, #151a1e);
    border: 1px solid var(--card-border, rgba(255,255,255,0.06));
    border-radius: var(--card-radius, 12px);
    padding: 20px;
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
}
.menu-inspector-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px 20px;
    text-align: center;
    color: var(--text-muted, #7a8a9e);
}
.menu-inspector-title { margin: 0 0 12px; font-size: 16px; }
.menu-inspector-meta { font-size: 13px; color: var(--text-secondary, #b0bdc9); }
.menu-inspector-meta table { width: 100%; border-collapse: collapse; }
.menu-inspector-meta td { padding: 6px 0; border-bottom: 1px solid var(--surface-200, rgba(255,255,255,0.04)); }
.menu-inspector-meta td:first-child { color: var(--text-muted, #7a8a9e); width: 100px; }
.menu-inspector-actions {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    flex-wrap: wrap;
}

/* ── Button icon ── */
.btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: var(--text-secondary, #b0bdc9);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
.btn-icon:hover {
    background: var(--surface-200, rgba(255,255,255,0.08));
    color: var(--text-primary, #e6eef6);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const tree = document.getElementById('menuTree');
    const saveBtn = document.getElementById('menuSaveOrder');
    const inspector = document.getElementById('menuInspector');
    const locationId = tree?.dataset?.locationId;
    let orderChanged = false;
    let draggedEl = null;

    // ── Inspector ──────────────────────────────────────────────────
    tree?.addEventListener('click', function (e) {
        const inspectTarget = e.target.closest('[data-inspect]');
        if (!inspectTarget) return;

        const item = inspectTarget.closest('.menu-tree-item');
        if (!item) return;

        // Remove previous selection
        tree.querySelectorAll('.menu-tree-item.selected').forEach(el => el.classList.remove('selected'));
        item.classList.add('selected');

        const id = item.dataset.id;
        const key = item.dataset.key;
        const source = item.dataset.source;
        const targetType = item.dataset.targetType;
        const targetValue = item.dataset.targetValue;
        const label = item.querySelector('.menu-tree-item-label')?.textContent?.trim() || key;

        const emptyEl = inspector.querySelector('.menu-inspector-empty');
        const contentEl = inspector.querySelector('.menu-inspector-content');
        if (emptyEl) emptyEl.style.display = 'none';
        if (contentEl) contentEl.style.display = '';

        document.getElementById('inspectorTitle').textContent = label;
        document.getElementById('inspectorMeta').innerHTML = `
            <table>
                <tr><td>Key</td><td><code>${escHtml(key)}</code></td></tr>
                <tr><td>ID</td><td>${escHtml(id)}</td></tr>
                <tr><td>Quelle</td><td><span class="badge badge-source badge-${escHtml(source)}">${escHtml(source)}</span></td></tr>
                <tr><td>Typ</td><td>${escHtml(targetType)}</td></tr>
                <tr><td>Ziel</td><td>${escHtml(targetValue || '—')}</td></tr>
            </table>
        `;
        // Build inspector actions: if id is present use edit/toggle/delete, otherwise offer create link
        let actionsHtml = '';
        if (id && id !== '') {
            actionsHtml += `<a href="/admin/menus/items/${id}/edit" class="btn btn-sm btn-primary">Bearbeiten</a>`;
            actionsHtml += `<form method="post" action="/admin/menus/items/${id}/toggle" style="display:inline">`;
            actionsHtml += `<input type="hidden" name="_csrf_token" value="${document.querySelector('meta[name=csrf-token]')?.content || ''}">`;
            actionsHtml += `<button type="submit" class="btn btn-sm btn-outline">${item.classList.contains('is-hidden') ? 'Einblenden' : 'Ausblenden'}</button>`;
            actionsHtml += `</form>`;
            actionsHtml += `<form method="post" action="/admin/menus/items/${id}/delete" style="display:inline" onsubmit="return confirm('Eintrag wirklich löschen?')">`;
            actionsHtml += `<input type="hidden" name="_csrf_token" value="${document.querySelector('meta[name=csrf-token]')?.content || ''}">`;
            actionsHtml += `<button type="submit" class="btn btn-sm btn-danger">Löschen</button>`;
            actionsHtml += `</form>`;
        } else {
            actionsHtml = `<a href="/admin/menus/locations/${locationId}/items/create" class="btn btn-sm btn-primary">Neuen Eintrag erstellen</a>`;
        }
        document.getElementById('inspectorActions').innerHTML = actionsHtml;
    });

    function escHtml(str) {
        const d = document.createElement('div');
        d.textContent = str || '';
        return d.innerHTML;
    }

    // ── Drag & Drop ───────────────────────────────────────────────
    tree?.addEventListener('dragstart', function (e) {
        const item = e.target.closest('.menu-tree-item');
        if (!item) return;
        draggedEl = item;
        item.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', item.dataset.id);
    });

    tree?.addEventListener('dragend', function (e) {
        if (draggedEl) {
            draggedEl.classList.remove('dragging');
            draggedEl = null;
        }
        tree.querySelectorAll('.drag-over, .drag-over-group').forEach(el => {
            el.classList.remove('drag-over', 'drag-over-group');
        });
    });

    tree?.addEventListener('dragover', function (e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';

        const target = e.target.closest('.menu-tree-item');
        const group = e.target.closest('.sortable-group');

        // Clear previous indicators
        tree.querySelectorAll('.drag-over, .drag-over-group').forEach(el => {
            el.classList.remove('drag-over', 'drag-over-group');
        });

        if (target && target !== draggedEl) {
            target.classList.add('drag-over');
        } else if (group) {
            group.classList.add('drag-over-group');
        }
    });

    tree?.addEventListener('drop', function (e) {
        e.preventDefault();
        if (!draggedEl) return;

        const target = e.target.closest('.menu-tree-item');
        const group = e.target.closest('.sortable-group');

        if (target && target !== draggedEl) {
            // Determine insertion position
            const rect = target.getBoundingClientRect();
            const midY = rect.top + rect.height / 2;
            const targetGroup = target.parentElement;

            if (e.clientY < midY) {
                targetGroup.insertBefore(draggedEl, target);
            } else {
                // If target has children group, insert into children
                const childGroup = target.querySelector(':scope > .menu-tree-children');
                if (childGroup && e.clientY > rect.top + rect.height * 0.7) {
                    childGroup.insertBefore(draggedEl, childGroup.firstChild);
                } else {
                    targetGroup.insertBefore(draggedEl, target.nextSibling);
                }
            }
            markOrderChanged();
        } else if (group && !group.contains(draggedEl)) {
            group.appendChild(draggedEl);
            markOrderChanged();
        }

        tree.querySelectorAll('.drag-over, .drag-over-group').forEach(el => {
            el.classList.remove('drag-over', 'drag-over-group');
        });
    });

    function markOrderChanged() {
        orderChanged = true;
        saveBtn.disabled = false;
        saveBtn.classList.add('btn-primary');
        saveBtn.classList.remove('btn-outline');
    }

    // ── Save Order ────────────────────────────────────────────────
    saveBtn?.addEventListener('click', function () {
        if (!orderChanged) return;

        const items = [];
        const allItems = tree.querySelectorAll('.menu-tree-item');

        allItems.forEach(function (el, index) {
            const parentItem = el.parentElement.closest('.menu-tree-item');
            const parentGroup = el.parentElement.closest('.sortable-group');
            const catId = parentGroup?.dataset?.categoryId || null;

            items.push({
                id: parseInt(el.dataset.id),
                sort_order: index * 10,
                parent_id: parentItem ? parseInt(parentItem.dataset.id) : null,
                category_id: catId ? parseInt(catId) : null,
            });
        });

        saveBtn.disabled = true;
        saveBtn.textContent = 'Speichern...';

        fetch('/admin/menus/api/reorder', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name=csrf-token]')?.content || ''
            },
            body: JSON.stringify({ items: items })
        })
        .then(r => r.json())
        .then(data => {
            if (data.ok) {
                orderChanged = false;
                saveBtn.classList.remove('btn-primary');
                saveBtn.classList.add('btn-outline');
                saveBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Gespeichert!';
                setTimeout(() => {
                    saveBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Reihenfolge speichern';
                }, 2000);
            } else {
                saveBtn.disabled = false;
                alert('Fehler beim Speichern: ' + (data.error || 'Unbekannter Fehler'));
            }
        })
        .catch(err => {
            saveBtn.disabled = false;
            alert('Netzwerkfehler: ' + err.message);
        });
    });
});
</script>
{% endblock %}
