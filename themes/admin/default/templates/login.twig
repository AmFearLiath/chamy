<!DOCTYPE html>
<html lang="{{ app_locale|default('de') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ t('admin.login')|default('Anmelden') }} – Chamy CMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/themes/admin/default/assets/css/admin.css">
</head>
<body class="login-page">

<div class="login-card glow-border">
    <div class="login-logo">
        <img src="/logo.png" alt="Chamy" class="login-logo-img">
    </div>

    {% if error is defined and error %}
    <div class="alert alert-danger" style="margin-bottom:20px;">{{ error }}</div>
    {% endif %}

    <form class="login-form" method="POST" action="/admin/login">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <div class="form-group">
            <label class="form-label" for="username">{{ t('admin.username')|default('Benutzername') }}</label>
            <input class="form-input" type="text" id="username" name="username"
                   value="{{ username|default('') }}" autocomplete="username" autofocus required>
        </div>

        <div class="form-group">
            <label class="form-label" for="password">{{ t('admin.password')|default('Passwort') }}</label>
            <input class="form-input" type="password" id="password" name="password"
                   autocomplete="current-password" required>
        </div>

        <button class="btn btn-primary" type="submit">{{ t('admin.login')|default('Anmelden') }}</button>
    </form>
</div>

<script src="/themes/admin/default/assets/js/admin.js"></script>
</body>
</html>
