        .card-body::-webkit-scrollbar-thumb, .table-responsive::-webkit-scrollbar-thumb, .themed-multiselect::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.14); border-radius: 6px; }
        .asset-check-results { display:grid; gap:6px; padding:8px; border:1px solid rgba(255,255,255,0.08); border-radius:8px; max-height:150px; overflow:auto; }
