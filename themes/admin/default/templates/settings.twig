    <script>
        (function () {
            // Open/close using project chamy-modal pattern
            function openFontModal(id) { var m = document.getElementById(id); if (!m) return; m.style.display = 'flex'; m.setAttribute('aria-hidden','false'); document.body.style.overflow = 'hidden'; }
            function closeFontModal(id) { var m = document.getElementById(id); if (!m) return; m.style.display = 'none'; m.setAttribute('aria-hidden','true'); document.body.style.overflow = ''; }
            // Open API modal with additional behavior: refresh stored status and prompt for entry
            function openApiModal() {
                openFontModal('modal-api');
                var line = document.getElementById('api-status-line');
                if (line) line.textContent = '{{ t('admin.settings_api_prompt')|default('Trage deinen Key zur Prüfung ein') }}';
                // refresh stored status quickly
                fetch('/admin/api/google-fonts/status').then(function (r) { return r.json(); }).then(function (j) {
                    var p = payloadFromResponse(j) || {};
                    _lastApiStatus = p;
                    if (p && p.message === 'No API key configured') {
                        setBadgeState('none');
                    } else if (p && p.ok) {
                        setBadgeState('ok');
                    } else {
                        setBadgeState('error');
                    }
                    refreshStatusLineFromPayload(p);
                }).catch(function () {
                    setBadgeState('error');
                });

                    // Trigger input check if value present
                    var form = document.getElementById('form-api-key');
                    if (form) {
                        var input = form.querySelector('input[name="google_api_key"]');
                        setTimeout(function () { if (input && input.value) input.dispatchEvent(new Event('input')); }, 200);
                    }
                }

            // Also refresh stored-key status when page/tab becomes visible
            document.addEventListener('visibilitychange', function () {
                if (document.visibilityState === 'visible') {
                    fetch('/admin/api/google-fonts/status').then(function (r) { return r.json(); }).then(function (j) {
                        var p = payloadFromResponse(j) || {};
                        _lastApiStatus = p;
                        if (p && p.message === 'No API key configured') setBadgeState('none'); else if (p && p.ok) setBadgeState('ok'); else setBadgeState('error');
                        refreshStatusLineFromPayload(p);
                    }).catch(function () {
                        setBadgeState('error');
                    });
                }
            });

            document.getElementById('btn-open-analyze').addEventListener('click', function(){ openFontModal('modal-analyze'); });
            document.getElementById('btn-open-import').addEventListener('click', function(){ openFontModal('modal-import'); });
            document.getElementById('googleApiBadge').addEventListener('click', function(){ openApiModal(); });
            document.querySelectorAll('[data-close-font-modal]').forEach(function(btn){ btn.addEventListener('click', function(e){ var m = e.target.closest('.chamy-modal'); if (m) closeFontModal(m.id); }); });
            // close when clicking overlay outside dialog
            document.querySelectorAll('.chamy-modal').forEach(function(m){
                m.addEventListener('click', function(e){ if (e.target === m) { closeFontModal(m.id); } });
            });

            // API badge status: use explicit api-badge classes to avoid theme overrides
            var badge = document.getElementById('googleApiBadge');
            function setBadgeState(state) {
                if (!badge) return;
                // Normalize: always keep base btn btn-sm and our api-badge class
                var base = 'btn btn-sm api-badge';
                badge.textContent = 'API';
                if (state === 'ok') {
                    badge.className = base + ' api-badge-ok';
                } else if (state === 'checking') {
                    badge.className = base + ' api-badge-checking';
                } else if (state === 'none') {
                    badge.className = base + ' api-badge-warning';
                } else {
                    badge.className = base + ' api-badge-error';
                }
            }

            setBadgeState('none');

            // Helper to normalize API wrapper responses (Response::apiSuccess)
            function payloadFromResponse(obj) {
                if (!obj) return null;
                if (obj.data !== undefined) return obj.data;
                return obj;
            }

            // Track last known status
            var _lastApiStatus = null;
            function refreshStatusLineFromPayload(p) {
                var line = document.getElementById('api-status-line');
                if (!line) return;
                if (!p) { line.textContent = '' ; return; }
                if (p.message) { line.textContent = p.message; return; }
                line.textContent = p.ok ? '{{ t('admin.settings_api_connected')|default('API verbunden') }}' : '{{ t('admin.settings_api_not_connected')|default('API nicht verbunden') }}';
            }

            // Initial status check using stored key on server
            fetch('/admin/api/google-fonts/status').then(function (r) { return r.json(); }).then(function (j) {
                var p = payloadFromResponse(j) || {};
                _lastApiStatus = p;
                if (p && p.message === 'No API key configured') {
                    setBadgeState('none');
                    var line = document.getElementById('api-status-line');
                    if (line) line.textContent = '{{ t('admin.settings_api_not_connected_help')|default('Kein API‑Key konfiguriert.') }}';
                    return;
                }
                if (p && p.ok) setBadgeState('ok'); else setBadgeState('error');
                refreshStatusLineFromPayload(p);
            }).catch(function () {
                setBadgeState('error');
                var line = document.getElementById('api-status-line');
                if (line) line.innerHTML = '{{ t('admin.settings_api_not_connected_help')|default('API nicht verbunden. Klick auf Badge zum Eintragen/Erneuern des Keys.') }} <a href="https://console.cloud.google.com/apis/credentials" target="_blank">{{ t('admin.settings_api_get_key')|default('API-Key holen') }}</a>';
            });

            // Debounced in-place key check (POST /admin/api/google-fonts/check)
            (function () {
                var form = document.getElementById('form-api-key');
                if (!form) return;
                var input = form.querySelector('input[name="google_api_key"]');
                var statusLine = document.getElementById('api-status-line');
                var timer = null;

                function doCheck(key) {
                    // If no key provided in input, prefer stored key status if present
                    if (!key || key.trim() === '') {
                        if (_lastApiStatus && (_lastApiStatus.message !== 'No API key configured')) {
                            // use last known stored-key status
                            if (_lastApiStatus.ok) setBadgeState('ok'); else setBadgeState('error');
                            if (statusLine) refreshStatusLineFromPayload(_lastApiStatus);
                            return;
                        }
                        setBadgeState('none');
                        if (statusLine) statusLine.textContent = '{{ t('admin.settings_api_not_connected_help')|default('Kein API‑Key konfiguriert. Trage deinen Key zur Prüfung ein.') }}';
                        return;
                    }
                    // Quick regex validation for typical API keys (starts with 'AIza' + 35 chars)
                    var keyRegex = /^AIza[0-9A-Za-z\-_]{35}$/;
                    if (!keyRegex.test(key.trim())) {
                        setBadgeState('error');
                        if (statusLine) statusLine.textContent = '{{ t('admin.settings_api_key_invalid')|default('Key ungültig (Format stimmt nicht).') }}';
                        return;
                    }
                    // Indicate checking
                    setBadgeState('checking');
                    if (statusLine) statusLine.textContent = '{{ t('admin.settings_api_checking')|default('Prüfe API‑Key...') }}';

                    fetch('/admin/api/google-fonts/check', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'key=' + encodeURIComponent(key),
                    }).then(function (r) { return r.json(); }).then(function (j) {
                        var p = payloadFromResponse(j) || {};
                        _lastApiStatus = p;
                        if (p && p.ok) {
                            setBadgeState('ok');
                            if (statusLine) statusLine.textContent = p.message || '{{ t('admin.settings_api_connected')|default('API verbunden') }}';
                        } else {
                            setBadgeState('error');
                            if (statusLine) statusLine.textContent = p.message || '{{ t('admin.settings_api_not_connected')|default('API nicht verbunden') }}';
                        }
                    }).catch(function () {
                        setBadgeState('error');
                        if (statusLine) statusLine.textContent = '{{ t('admin.settings_api_not_connected')|default('API nicht verbunden') }}';
                    });
                }

                input && input.addEventListener('input', function () {
                    if (timer) clearTimeout(timer);
                    var k = input.value || '';
                    timer = setTimeout(function () { doCheck(k); }, 500);
                });

                // Delete stored key: confirm, POST empty key, then refresh status
                var deleteBtn = document.getElementById('api-delete-btn');
                if (deleteBtn) {
                    deleteBtn.addEventListener('click', function () {
                        var confirmMsg = '{{ t('admin.settings_api_confirm_delete')|default('Delete stored API key?') }}';
                        if (!confirm(confirmMsg)) return;
                        var csrfEl = form.querySelector('input[name="csrf_token"]');
                        var csrf = csrfEl ? csrfEl.value : '';
                        var body = 'csrf_token=' + encodeURIComponent(csrf) + '&asset_action=google_api_key_save&google_api_key=';
                        fetch('/admin/settings', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
                            .then(function () { return fetch('/admin/api/google-fonts/status'); })
                            .then(function (r) { return r.json(); })
                            .then(function (j) {
                                var p = payloadFromResponse(j) || {};
                                _lastApiStatus = p;
                                if (p && p.message === 'No API key configured') setBadgeState('none'); else if (p && p.ok) setBadgeState('ok'); else setBadgeState('error');
                                refreshStatusLineFromPayload(p);
                                // clear input field
                                var inp = form.querySelector('input[name="google_api_key"]'); if (inp) inp.value = '';
                            }).catch(function () {
                                setBadgeState('error');
                                var s = document.getElementById('api-status-line'); if (s) s.textContent = '{{ t('admin.settings_api_not_connected')|default('API nicht verbunden') }}';
                            });
                    });
                }

                // When modal opens, try to check current value (if any)
                function openApiModal() {
                    openFontModal('modal-api');
                    var line = document.getElementById('api-status-line');
                    if (line) line.textContent = '{{ t('admin.settings_api_prompt')|default('Trage deinen Key zur Prüfung ein') }}';
                    // refresh stored status quickly
                    fetch('/admin/api/google-fonts/status').then(function (r) { return r.json(); }).then(function (j) {
                        var p = payloadFromResponse(j) || {};
                        _lastApiStatus = p;
                        if (p && p.message === 'No API key configured') {
                            setBadgeState('none');
                        } else if (p && p.ok) {
                            setBadgeState('ok');
                        } else {
                            setBadgeState('error');
                        }
                        refreshStatusLineFromPayload(p);
                    }).catch(function () {
                        setBadgeState('error');
                    });

                    // Trigger input check if value present
                    setTimeout(function () { if (input && input.value) input.dispatchEvent(new Event('input')); }, 200);
                }
            })();
        })();
    </script>
    <script>
        (function () {
            var input = document.getElementById('liveGoogleQ');
            var results = document.getElementById('googleSearchResults');
            var pager = document.getElementById('googleSearchPager');
            var perPageSelect = document.getElementById('livePerPage');
            var styleFilter = document.getElementById('liveStyleFilter');
            var categoryFilter = document.getElementById('liveCategoryFilter');
            var subcategoryFilter = document.getElementById('liveSubcategoryFilter');
            var familyInput = document.getElementById('fontPreviewFamily');
            var previewMeta = document.getElementById('fontPreviewMeta');
            var page = 1;
            var timer = null;

            function payloadFromResponse(obj) {
                if (!obj) return null;
                if (obj.data !== undefined) return obj.data;
                return obj;
            }

            function buildGoogleCssUrl(family, styles) {
                var normalized = (styles || []).slice(0, 8);
                var hasItalic = false;
                var weights = [];
                var italicWeights = [];
                normalized.forEach(function (s) {
                    var v = String(s || '').toLowerCase().trim();
                    if (!v || v === 'regular') { weights.push('400'); return; }
                    if (v === 'italic') { hasItalic = true; italicWeights.push('400'); return; }
                    if (/^[0-9]{3}italic$/.test(v)) {
                        hasItalic = true;
                        italicWeights.push(v.replace('italic', ''));
                        return;
                    }
                    if (/^[0-9]{3}$/.test(v)) {
                        weights.push(v);
                    }
                });

                weights = Array.from(new Set(weights)).sort();
                italicWeights = Array.from(new Set(italicWeights)).sort();

                var familyParam = String(family || '').replace(/\s+/g, '+');
                if (hasItalic) {
                    var pairs = [];
                    weights.forEach(function (w) { pairs.push('0,' + w); });
                    italicWeights.forEach(function (w) { pairs.push('1,' + w); });
                    if (pairs.length === 0) pairs.push('0,400');
                    familyParam += ':ital,wght@' + pairs.join(';');
                } else if (weights.length > 0) {
                    familyParam += ':wght@' + weights.join(';');
                }

                return 'https://fonts.googleapis.com/css2?family=' + encodeURI(familyParam) + '&display=swap';
            }

            function setLivePreview(font, cssUrl) {
                if (cssUrl && window.ChamyFontLoader && typeof window.ChamyFontLoader.load === 'function') {
                    window.ChamyFontLoader.load(cssUrl);
                }
                if (familyInput) {
                    familyInput.value = font.family || '';
                    familyInput.dispatchEvent(new Event('change'));
                }
                if (previewMeta) {
                    previewMeta.textContent = cssUrl || '';
                }
            }

            function renderCategoryFilters(data) {
                if (!categoryFilter) return;
                var current = categoryFilter.value || '';
                var html = '<option value="">{{ t("admin.settings_assets_filter_all")|default("Alle") }}</option>';
                (data.categories || []).forEach(function (cat) {
                    html += '<option value="' + String(cat.id || '').replace(/"/g, '&quot;') + '">' + String(cat.label || cat.id || '') + '</option>';
                });
                categoryFilter.innerHTML = html;
                if (current) categoryFilter.value = current;
            }

            function renderSubcategoryFilters(data) {
                if (!subcategoryFilter) return;
                var selectedCategory = categoryFilter && categoryFilter.value ? categoryFilter.value : '';
                if (!selectedCategory) {
                    subcategoryFilter.style.display = 'none';
                    subcategoryFilter.innerHTML = '';
                    return;
                }

                var current = subcategoryFilter.value || '';
                var html = '<option value="">{{ t("admin.settings_assets_filter_all")|default("Alle") }}</option>';
                (data.subcategories || []).forEach(function (sub) {
                    html += '<option value="' + String(sub.id || '').replace(/"/g, '&quot;') + '">' + String(sub.label || sub.id || '') + '</option>';
                });
                subcategoryFilter.innerHTML = html;
                subcategoryFilter.style.display = 'inline-block';
                if (current) subcategoryFilter.value = current;
            }

            function renderResults(data) {
                results.innerHTML = '';
                (data.items || []).forEach(function (font) {
                    var row = document.createElement('div');
                    row.style.display = 'grid';
                    row.style.gridTemplateColumns = '1fr auto';
                    row.style.gap = '8px';

                    var info = document.createElement('div');
                    var title = document.createElement('strong');
                    title.textContent = font.family;
                    var meta = document.createElement('div');
                    meta.className = 'text-muted';
                    meta.style.fontSize = '12px';
                    var styleList = (font.styles || []).slice(0, 6).join(', ');
                    var parts = [font.category, font.subcategory, styleList].filter(Boolean);
                    meta.textContent = parts.join(' | ');
                    info.appendChild(title);
                    info.appendChild(meta);
                    if (font.installed) {
                        var badge = document.createElement('div');
                        badge.className = 'text-muted';
                        badge.style.fontSize = '11px';
                        badge.textContent = '{{ t("admin.installed")|default("Installiert") }}';
                        info.appendChild(badge);
                    }

                    var actions = document.createElement('div');
                    actions.style.display = 'flex';
                    actions.style.gap = '6px';

                    var previewBtn = document.createElement('button');
                    previewBtn.type = 'button';
                    previewBtn.className = 'btn btn-sm btn-secondary';
                    previewBtn.textContent = '{{ t("admin.settings_assets_preview")|default("Vorschau") }}';
                    previewBtn.addEventListener('click', function () {
                        var family = font.family || '';
                        // If installed: use only local CSS
                        if (font.installed && font.installed_set && font.installed_set.local_css) {
                            var cssUrl = font.installed_set.local_css;
                            // remove any previously injected remote CSS
                            var prev = document.getElementById('chamy-live-remote-css'); if (prev) prev.parentNode.removeChild(prev);
                            setLivePreview(font, cssUrl);
                        } else {
                            // Not installed: fetch Google CSS via HTTP and inject into document head
                            var cssUrl = buildGoogleCssUrl(family, font.styles || font.variants || []);
                            // remove previous injected remote CSS link
                            var prev = document.getElementById('chamy-live-remote-css'); if (prev) prev.parentNode.removeChild(prev);
                            try {
                                var linkEl = document.createElement('link');
                                linkEl.id = 'chamy-live-remote-css';
                                linkEl.rel = 'stylesheet';
                                linkEl.href = cssUrl;
                                // When the stylesheet loads, apply the preview family
                                linkEl.onload = function () {
                                    if (familyInput) { familyInput.value = family; familyInput.dispatchEvent(new Event('change')); }
                                    if (previewMeta) previewMeta.textContent = cssUrl;
                                };
                                linkEl.onerror = function () {
                                    console.error('Failed to load remote font CSS', cssUrl);
                                    alert('{{ t("system.error")|default("Fehler") }}');
                                };
                                document.head.appendChild(linkEl);
                            } catch (e) {
                                console.error('Inject link failed', e);
                                alert('{{ t("system.error")|default("Fehler") }}');
                            }
                        }
                    });
                    actions.appendChild(previewBtn);

                    if (font.installed) {
                        var installedBtn = document.createElement('button');
                        installedBtn.type = 'button';
                        installedBtn.className = 'btn btn-sm btn-success';
                        installedBtn.disabled = true;
                        installedBtn.textContent = '{{ t("admin.installed")|default("Installiert") }}';
                        actions.appendChild(installedBtn);
                    } else {
                        var installForm = document.createElement('form');
                        installForm.method = 'post';
                        installForm.action = '/admin/settings';
                        installForm.style.display = 'inline-block';
                        installForm.innerHTML = '<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">'
                            + '<input type="hidden" name="asset_action" value="fonts.google_install">'
                            + '<input type="hidden" name="google_family" value="' + String(font.family || '').replace(/"/g, '&quot;') + '">';

                        (font.styles || []).slice(0, 8).forEach(function (s) {
                            var inp = document.createElement('input');
                            inp.type = 'hidden';
                            inp.name = 'google_styles[]';
                            inp.value = s;
                            installForm.appendChild(inp);
                        });

                        ['admin', 'frontend'].forEach(function (a) {
                            var ia = document.createElement('input');
                            ia.type = 'hidden';
                            ia.name = 'areas[]';
                            ia.value = a;
                            installForm.appendChild(ia);
                        });
                        ['system', 'theme', 'mods'].forEach(function (a) {
                            var ia = document.createElement('input');
                            ia.type = 'hidden';
                            ia.name = 'allow_for[]';
                            ia.value = a;
                            installForm.appendChild(ia);
                        });

                        var installBtn = document.createElement('button');
                        installBtn.type = 'submit';
                        installBtn.className = 'btn btn-sm btn-primary';
                        installBtn.textContent = '{{ t("admin.settings_assets_install")|default("Installieren") }}';
                        installForm.appendChild(installBtn);
                        actions.appendChild(installForm);
                    }

                    row.appendChild(info);
                    row.appendChild(actions);
                    results.appendChild(row);
                });
            }

            function renderPager(data) {
                pager.innerHTML = '';
                var total = parseInt(data.total || 0, 10) || 0;
                var pages = parseInt(data.pages || 1, 10) || 1;
                var currentPage = parseInt(data.page || 1, 10) || 1;

                if (pages <= 1) {
                    if (total === 0) {
                        var empty = document.createElement('div');
                        empty.className = 'text-muted';
                        empty.textContent = '{{ t("admin.settings_assets_no_sets")|default("Keine Sets vorhanden.") }}';
                        pager.appendChild(empty);
                    }
                    return;
                }

                var prev = document.createElement('button');
                prev.type = 'button';
                prev.className = 'btn btn-sm btn-secondary';
                prev.textContent = '‹';
                prev.disabled = currentPage <= 1;
                prev.addEventListener('click', function () { page = Math.max(1, currentPage - 1); fetchSearch(); });

                var next = document.createElement('button');
                next.type = 'button';
                next.className = 'btn btn-sm btn-secondary';
                next.textContent = '›';
                next.disabled = currentPage >= pages;
                next.addEventListener('click', function () { page = Math.min(pages, currentPage + 1); fetchSearch(); });

                var info = document.createElement('div');
                info.style.alignSelf = 'center';
                info.textContent = currentPage + ' / ' + pages + ' (' + total + ')';

                pager.appendChild(prev);
                pager.appendChild(info);
                pager.appendChild(next);
            }

            function fetchSearch() {
                var params = new URLSearchParams();
                params.set('q', input && input.value ? input.value.trim() : '');
                params.set('style', styleFilter && styleFilter.value ? styleFilter.value : '');
                params.set('category', categoryFilter && categoryFilter.value ? categoryFilter.value : '');
                params.set('subcategory', subcategoryFilter && subcategoryFilter.value ? subcategoryFilter.value : '');
                params.set('page', String(page));
                params.set('per_page', String(parseInt(perPageSelect.value, 10) || 10));

                results.innerHTML = '<div class="text-muted">Lade…</div>';
                fetch('/admin/api/google-fonts/search?' + params.toString(), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (json) {
                        var data = payloadFromResponse(json) || {};
                        renderCategoryFilters(data);
                        renderSubcategoryFilters(data);
                        renderResults(data);
                        renderPager(data);
                    })
                    .catch(function () {
                        results.innerHTML = '<div class="text-muted">Suche fehlgeschlagen.</div>';
                        pager.innerHTML = '';
                    });
            }

            function onInputChanged() {
                page = 1;
                if (timer) clearTimeout(timer);
                timer = setTimeout(fetchSearch, 250);
            }

            [input, perPageSelect, styleFilter].forEach(function (el) {
                if (!el) return;
                el.addEventListener('input', onInputChanged);
                el.addEventListener('change', onInputChanged);
            });

            if (categoryFilter) {
                categoryFilter.addEventListener('change', function () {
                    page = 1;
                    if (subcategoryFilter) subcategoryFilter.value = '';
                    fetchSearch();
                });
            }

            if (subcategoryFilter) {
                subcategoryFilter.addEventListener('change', function () {
                    page = 1;
                    fetchSearch();
                });
            }

            fetchSearch();
        })();
    </script>

    {% for group_name, group_settings in settings %}
    <div id="tab-settings-{{ group_name|lower|replace({' ':'-'}) }}" class="tab-panel {{ asset_active_tab == '' and loop.first ? 'active' : '' }}">
        <form method="post" action="/admin/settings">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header">
                    <h3 style="margin: 0; text-transform: capitalize;">{{ group_name }}</h3>
                </div>
                <div class="card-body">
                    <div class="settings-grid">
                        {% for key, setting in group_settings %}
                        <div class="form-group settings-item">
                            <label class="form-label" for="setting_{{ setting.id }}">{{ setting.key }}</label>
                            {% if setting.type == 'boolean' %}
                            <select name="settings[{{ setting.id }}]" id="setting_{{ setting.id }}" class="form-control" {{ not can_manage_settings ? 'disabled' : '' }}>
                                <option value="1" {{ setting.value == '1' ? 'selected' : '' }}>{{ t('admin.yes')|default('Ja') }}</option>
                                <option value="0" {{ setting.value == '0' ? 'selected' : '' }}>{{ t('admin.no')|default('Nein') }}</option>
                            </select>
                            {% elseif setting.type == 'integer' %}
                            <input type="number" name="settings[{{ setting.id }}]" id="setting_{{ setting.id }}" class="form-control" value="{{ setting.value }}" {{ not can_manage_settings ? 'disabled' : '' }}>
                            {% else %}
                            <input type="text" name="settings[{{ setting.id }}]" id="setting_{{ setting.id }}" class="form-control" value="{{ setting.value }}" {{ not can_manage_settings ? 'disabled' : '' }}>
                            {% endif %}
                            <small class="form-hint text-muted">{{ group_name }}.{{ setting.key }} ({{ setting.type }})</small>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div style="text-align: right;">
                <button type="submit" class="btn btn-primary" {{ not can_manage_settings ? 'disabled' : '' }}>{{ t('admin.save_settings')|default('Einstellungen speichern') }}</button>
            </div>
        </form>
    </div>
    {% endfor %}
</div>
{% endblock %}
