    <script>
        (function () {
            var familyInput = document.getElementById('fontPreviewFamily');
            var textInput = document.getElementById('fontPreviewText');
            var sizeInput = document.getElementById('fontPreviewSize');
            var previewBox = document.getElementById('fontPreviewBox');
            var previewMeta = document.getElementById('fontPreviewMeta');
            var detailModal = document.getElementById('modal-font-detail');

            function openDetailModal() {
                if (!detailModal) return;
                detailModal.style.display = 'flex';
                detailModal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }

            function setDetailField(id, value) {
                var el = document.getElementById(id);
                if (!el) return;
                el.textContent = value || '-';
            }

            function renderDetailPreview(family) {
                var box = document.getElementById('fontDetailPreview');
                if (!box) return;
                box.style.fontFamily = "'" + family + "', sans-serif";
            }

            function renderPreview() {
                if (!previewBox) return;
                var family = (familyInput && familyInput.value ? familyInput.value : 'Inter').trim();
                var text = textInput && textInput.value ? textInput.value : 'Sphinx of black quartz, judge my vow. 0123456789';
                var size = sizeInput && sizeInput.value ? parseInt(sizeInput.value, 10) : 32;
                if (Number.isNaN(size) || size < 12) size = 12;
                if (size > 72) size = 72;

                previewBox.style.fontFamily = "'" + family + "', sans-serif";
                previewBox.style.fontSize = size + 'px';
                previewBox.textContent = text;
            }

            document.addEventListener('click', function (e) {
                var trigger = e.target.closest('[data-font-preview]');
                if (!trigger) return;
                var css = trigger.getAttribute('data-font-css') || '';
                var family = trigger.getAttribute('data-font-family') || '';
                if (css && window.ChamyFontLoader && typeof window.ChamyFontLoader.load === 'function') {
                    window.ChamyFontLoader.load(css);
                }
                if (familyInput && family) {
                    familyInput.value = family;
                }
                if (previewMeta) {
                    previewMeta.textContent = css;
                }
                renderPreview();

                if (trigger.hasAttribute('data-font-detail')) {
                    setDetailField('fontDetailId', trigger.getAttribute('data-font-id') || '');
                    setDetailField('fontDetailProvider', trigger.getAttribute('data-font-provider') || '');
                    setDetailField('fontDetailStyles', trigger.getAttribute('data-font-styles') || '');
                    setDetailField('fontDetailAssets', trigger.getAttribute('data-font-assets') || '0');
                    setDetailField('fontDetailCss', css);
                    setDetailField('fontDetailStatus', trigger.getAttribute('data-font-status') || '');
                    setDetailField('fontDetailSource', trigger.getAttribute('data-font-source') || '');
                    renderDetailPreview(family);
                    openDetailModal();
                }
            });

            [familyInput, textInput, sizeInput].forEach(function (el) {
                if (!el) return;
                el.addEventListener('input', renderPreview);
                el.addEventListener('change', renderPreview);
            });

            renderPreview();
        })();
    </script>

