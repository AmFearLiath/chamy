    <script>
        (function () {
            var modal = document.getElementById('iconSourceModal');
            var checkBtn = document.getElementById('icon-check-package-btn');
            var checkResults = document.getElementById('icon-check-results');
            var templateSelect = document.getElementById('icon-template-select');
            var packageInput = document.getElementById('icon-package-input');
            var versionInput = document.getElementById('icon-version-input');
            var cssList = document.getElementById('icon-css-list');
            var jsList = document.getElementById('icon-js-list');
            var fontList = document.getElementById('icon-font-list');

            function textOrEmpty(el) {
                return el && typeof el.value === 'string' ? el.value.trim() : '';
            }

            function mirrorInstallFields() {
                var mTemplate = document.getElementById('icon-install-template-id');
                var mPackage = document.getElementById('icon-install-package');
                var mVersion = document.getElementById('icon-install-version');
                var mCss = document.getElementById('icon-install-css');
                var mJs = document.getElementById('icon-install-js');
                var mFonts = document.getElementById('icon-install-fonts');
                var sTemplate = document.getElementById('icon-source-template-id');
                var sPackage = document.getElementById('icon-source-package');
                var sLatest = document.getElementById('icon-source-latest-version');

                if (mTemplate) mTemplate.value = textOrEmpty(templateSelect);
                if (mPackage) mPackage.value = textOrEmpty(packageInput);
                if (mVersion) mVersion.value = textOrEmpty(versionInput) || 'latest';
                if (mCss) mCss.value = cssList ? cssList.value : '';
                if (mJs) mJs.value = jsList ? jsList.value : '';
                if (mFonts) mFonts.value = fontList ? fontList.value : '';

                if (sTemplate) sTemplate.value = textOrEmpty(templateSelect);
                if (sPackage) sPackage.value = textOrEmpty(packageInput);
                if (sLatest) sLatest.value = document.getElementById('icon-latest-version') ? document.getElementById('icon-latest-version').textContent.trim() : '';
            }

            function activateSideTab(tab) {
                document.querySelectorAll('[data-asset-side-tab]').forEach(function(btn){ btn.classList.remove('active'); });
                document.querySelectorAll('[data-asset-side-panel]').forEach(function(panel){ panel.classList.remove('active'); });
                var activeBtn = document.querySelector('[data-asset-side-tab="' + tab + '"]');
                var activePanel = document.querySelector('[data-asset-side-panel="' + tab + '"]');
                if (activeBtn) activeBtn.classList.add('active');
                if (activePanel) activePanel.classList.add('active');
            }

            function activateModalTab(tab) {
                document.querySelectorAll('[data-modal-tab]').forEach(function(btn){ btn.classList.remove('active'); });
                document.querySelectorAll('[data-modal-panel]').forEach(function(panel){ panel.classList.remove('active'); });
                var activeBtn = document.querySelector('[data-modal-tab="' + tab + '"]');
                var activePanel = document.querySelector('[data-modal-panel="' + tab + '"]');
                if (activeBtn) activeBtn.classList.add('active');
                if (activePanel) activePanel.classList.add('active');
            }

            function getTemplateById(id) {
                if (!window.__ICON_TEMPLATES || !Array.isArray(window.__ICON_TEMPLATES)) return null;
                for (var i = 0; i < window.__ICON_TEMPLATES.length; i++) {
                    if (window.__ICON_TEMPLATES[i] && window.__ICON_TEMPLATES[i].id === id) return window.__ICON_TEMPLATES[i];
                }
                return null;
            }

            function parseLines(text) {
                if (!text) return [];
                return String(text).split(/\r?\n/).map(function (x) { return x.trim(); }).filter(Boolean);
            }

            function withTokens(value, pkg, version) {
                return String(value || '').replace(/\{package\}/g, pkg || '').replace(/\{version\}/g, version || 'latest');
            }

            function fillDefaultsForTemplate() {
                var tpl = getTemplateById(textOrEmpty(templateSelect));
                if (!tpl) return;
                if (cssList && textOrEmpty(cssList) === '') {
                    if (tpl.url_template && tpl.default_path) {
                        cssList.value = tpl.url_template.replace('{path}', tpl.default_path);
                    }
                }
            }

            function getInstalledVersionForPackage(pkg) {
                if (!pkg || !window.__ICON_SETS || !Array.isArray(window.__ICON_SETS)) return '';
                for (var i = 0; i < window.__ICON_SETS.length; i++) {
                    var set = window.__ICON_SETS[i] || {};
                    if (set.package && set.package === pkg) return String(set.version || '');
                }
                return '';
            }

            function updateVersionInfo(installed, latest) {
                var i = document.getElementById('icon-installed-version');
                var l = document.getElementById('icon-latest-version');
                if (i) i.textContent = installed || '—';
                if (l) l.textContent = latest || '—';
                mirrorInstallFields();
            }

            function fetchLatestVersion() {
                var tpl = getTemplateById(textOrEmpty(templateSelect));
                var pkg = textOrEmpty(packageInput);
                var installed = getInstalledVersionForPackage(pkg);
                if (!tpl || !pkg) {
                    updateVersionInfo(installed, '');
                    return;
                }

                var latestFallback = '';
                if (window.__ICON_SOURCES && Array.isArray(window.__ICON_SOURCES)) {
                    for (var i = 0; i < window.__ICON_SOURCES.length; i++) {
                        var src = window.__ICON_SOURCES[i] || {};
                        if (src.package === pkg && src.latest_version) {
                            latestFallback = String(src.latest_version);
                            break;
                        }
                    }
                }

                if (!tpl.versions_api) {
                    updateVersionInfo(installed, latestFallback);
                    return;
                }

                var apiUrl = String(tpl.versions_api).replace('{package}', encodeURIComponent(pkg));
                fetch(apiUrl, { headers: { 'Accept': 'application/json' } })
                    .then(function (res) { return res.json(); })
                    .then(function (json) {
                        var latest = json && json['dist-tags'] && json['dist-tags'].latest ? String(json['dist-tags'].latest) : latestFallback;
                        updateVersionInfo(installed, latest);
                        if (versionInput && textOrEmpty(versionInput) === '') {
                            versionInput.value = latest || 'latest';
                        }
                    })
                    .catch(function () {
                        updateVersionInfo(installed, latestFallback);
                        if (versionInput && textOrEmpty(versionInput) === '') {
                            versionInput.value = latestFallback || 'latest';
                        }
                    });
            }

            function openModal(url, name, id, pkg, tplId, version) {
                if (!modal) return;
                modal.style.display = 'flex';
                modal.setAttribute('aria-hidden', 'false');

                var sourceName = document.getElementById('icon-source-name');
                var sourceId = document.getElementById('icon-source-id');
                var sourceUrl = document.getElementById('icon-source-url-save');
                var setName = document.getElementById('icon-set-name');
                var setId = document.getElementById('icon-set-id');

                if (sourceName) sourceName.value = name || '';
                if (sourceId) sourceId.value = id || '';
                if (sourceUrl) sourceUrl.value = url || '';
                if (setName) setName.value = name || '';
                if (setId) setId.value = id || '';

                if (packageInput) packageInput.value = pkg || '';
                if (versionInput) versionInput.value = version || '';

                if (templateSelect) {
                    var picked = tplId || textOrEmpty(templateSelect);
                    if (picked) templateSelect.value = picked;
                }

                fillDefaultsForTemplate();
                fetchLatestVersion();
                mirrorInstallFields();

                if (checkResults) {
                    checkResults.style.display = 'none';
                    checkResults.innerHTML = '';
                }
            }

            function closeModal() {
                if (!modal) return;
                modal.style.display = 'none';
                modal.setAttribute('aria-hidden', 'true');
            }

            function runOptionalCheck() {
                if (!checkResults) return;

                var pkg = textOrEmpty(packageInput);
                var ver = textOrEmpty(versionInput) || 'latest';
                var lines = [];
                parseLines(cssList ? cssList.value : '').forEach(function (u) { lines.push({ type: 'css', url: withTokens(u, pkg, ver) }); });
                parseLines(jsList ? jsList.value : '').forEach(function (u) { lines.push({ type: 'js', url: withTokens(u, pkg, ver) }); });
                parseLines(fontList ? fontList.value : '').forEach(function (u) { lines.push({ type: 'font', url: withTokens(u, pkg, ver) }); });

                var packageOk = pkg !== '';
                var html = '<div class="asset-check-line"><strong>Paket</strong><span class="badge ' + (packageOk ? 'badge-success' : 'badge-danger') + '">' + (packageOk ? 'OK' : 'Fehlt') + '</span></div>';
                checkResults.innerHTML = html;
                checkResults.style.display = 'grid';

                lines.forEach(function (entry) {
                    var row = document.createElement('div');
                    row.className = 'asset-check-line';
                    row.innerHTML = '<code>' + entry.type.toUpperCase() + ': ' + entry.url + '</code><span class="badge badge-secondary">Prüfe...</span>';
                    checkResults.appendChild(row);
                    fetch(entry.url, { method: 'HEAD', mode: 'no-cors' })
                        .then(function () {
                            row.lastChild.className = 'badge badge-success';
                            row.lastChild.textContent = 'OK';
                        })
                        .catch(function () {
                            row.lastChild.className = 'badge badge-warning';
                            row.lastChild.textContent = 'Unbestätigt';
                        });
                });
            }

            document.addEventListener('click', function (e) {
                var sideTab = e.target.closest('[data-asset-side-tab]');
                if (sideTab) {
                    activateSideTab(sideTab.getAttribute('data-asset-side-tab'));
                }

                var modalTab = e.target.closest('[data-modal-tab]');
                if (modalTab) {
                    activateModalTab(modalTab.getAttribute('data-modal-tab'));
                }

                var opener = e.target.closest('[data-open-modal="iconSourceModal"]');
                if (opener) {
                    openModal(
                        opener.getAttribute('data-source-url') || '',
                        opener.getAttribute('data-source-name') || '',
                        opener.getAttribute('data-source-id') || '',
                        opener.getAttribute('data-source-package') || '',
                        opener.getAttribute('data-source-template') || '',
                        opener.getAttribute('data-source-version') || ''
                    );
                    activateModalTab('source');
                }
                if (e.target.closest('[data-close-icon-modal]')) {
                    closeModal();
                }
            });

            if (checkBtn) {
                checkBtn.addEventListener('click', runOptionalCheck);
            }
            [templateSelect, packageInput, versionInput, cssList, jsList, fontList].forEach(function (el) {
                if (!el) return;
                el.addEventListener('change', function () {
                    mirrorInstallFields();
                    if (el === templateSelect || el === packageInput) {
                        fillDefaultsForTemplate();
                        fetchLatestVersion();
                    }
                });
                el.addEventListener('input', mirrorInstallFields);
            });
            activateSideTab('import');
            mirrorInstallFields();
        })();
    </script>

    <script>
        // Expose server-provided sources/sets to modal JS for lookups
        window.__ICON_SOURCES = {{ icon_sources|default([])|json_encode|raw }};
        window.__ICON_SETS = {{ icon_sets|default([])|json_encode|raw }};
        window.__ICON_TEMPLATES = {{ icon_source_templates|default([])|json_encode|raw }};
    </script>


