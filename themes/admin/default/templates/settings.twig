        button.api-badge.api-badge-warning { background-color:#f39c12 !important; color:#fff !important; border-color:transparent !important; }
        button.api-badge.api-badge-error { background-color:#e74c3c !important; color:#fff !important; border-color:transparent !important; }
        button.api-badge.api-badge-checking { background-color:#f1c40f !important; color:#111 !important; border-color:transparent !important; }
        /* Tooltip for API Key helper */
        .tooltip-wrapper { position: relative; display:inline-block; }
        .tooltip-box { display:none; position:absolute; left:0; top:calc(100% + 8px); background: rgba(11,13,14,0.96); color: #e6e8ea; padding:12px; border-radius:8px; width:340px; font-size:0.9rem; box-shadow:0 6px 24px rgba(0,0,0,0.45); border:1px solid rgba(255,255,255,0.04); z-index:2200; }
        .tooltip-wrapper:focus-within .tooltip-box, .tooltip-wrapper:hover .tooltip-box { display:block; }
        .tooltip-box h4 { margin:0 0 8px 0; font-size:0.95rem; }
        .tooltip-box ul { margin:6px 0 0 18px; padding:0; }
        .tooltip-box li { margin-bottom:6px; }
