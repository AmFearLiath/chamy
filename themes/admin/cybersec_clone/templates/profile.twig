{% extends 'base.twig' %}

{% block title %}{{ t('admin.profile')|default('Profil') }} – Chamy CMS{% endblock %}

{% block breadcrumb %}
    <a href="/admin">Dashboard</a>
    <span class="breadcrumb-sep">›</span>
    <span>{{ t('admin.profile')|default('Profil') }}</span>
{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">{{ t('admin.profile')|default('Profil') }}</h1>
        <p class="page-subtitle">{{ t('admin.manage_profile')|default('Dein Account und Einstellungen') }}</p>
    </div>
</div>

<div class="card" style="max-width:820px;">
    <div class="card-body">
        <form method="POST" action="/admin/profile" class="form-grid">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

            <div class="form-row">
                <label class="form-label">{{ t('admin.username')|default('Benutzername') }}</label>
                <div class="form-control">{{ profile.username }}</div>
            </div>

            <div class="form-row">
                <label class="form-label" for="email">{{ t('admin.email')|default('E-Mail') }}</label>
                <input class="form-input" type="email" id="email" name="email" value="{{ profile.email }}" required>
            </div>

            <div class="form-row">
                <label class="form-label" for="display_name">{{ t('admin.display_name')|default('Anzeigename') }}</label>
                <input class="form-input" type="text" id="display_name" name="display_name" value="{{ profile.display_name }}">
            </div>

            <div class="form-row">
                <label class="form-label" for="password">{{ t('admin.password')|default('Passwort (leer lassen um unverändert)') }}</label>
                <input class="form-input" type="password" id="password" name="password" autocomplete="new-password">
            </div>

            <div class="form-row" style="grid-column:1/-1;display:flex;gap:8px;align-items:center;justify-content:space-between;">
                <div>
                    <button class="btn btn-primary" type="submit">{{ t('admin.save')|default('Speichern') }}</button>
                    <a href="/admin/logout" class="btn btn-ghost">{{ t('admin.logout')|default('Abmelden') }}</a>
                </div>
                <div class="muted">{{ t('admin.last_seen')|default('Zuletzt eingeloggt:') }} {{ profile.last_login_at|default('—') }}</div>
            </div>
        </form>
    </div>
</div>

{% endblock %}
