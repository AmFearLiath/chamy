{% extends 'base.twig' %}

{% block title %}{{ t('admin.trash')|default('Papierkorb') }} - Chamy CMS{% endblock %}

{% block breadcrumb %}
<a href="/admin">{{ t('admin.dashboard')|default('Dashboard') }}</a>
<span class="breadcrumb-sep">›</span>
<span>{{ t('admin.trash')|default('Papierkorb') }}</span>
{% endblock %}

{% block content %}
<div class="page-header" style="display: grid; grid-template-columns: 4fr 2fr repeat(1, 0fr);">
    <div class="page-header-left">
        <h1 class="page-title">{{ t('admin.trash')|default('Papierkorb') }}</h1>
    </div>

    <div class="trash-header" style="margin-bottom:1rem; display:grid; gap:12px; grid-template-columns: 1fr auto; align-items:start;">
        <div class="badge-cards" aria-hidden="false">
            <div class="badge-card badge-accent">
                <div class="badge-row">
                    <div class="badge-number">{{ trash_stats.total|default(0) }}</div>
                    <div class="badge-label">{{ t('trash.total')|default('Gesamt') }}</div>
                </div>
            </div>

            <div class="badge-card badge-teal">
                <div class="badge-row">
                    <div class="badge-number">{{ trash_stats.trashed|default(0) }}</div>
                    <div class="badge-label">{{ t('trash.trashed')|default('Im Papierkorb') }}</div>
                </div>
            </div>

            <div class="badge-card badge-green">
                <div class="badge-row">
                    <div class="badge-number">{{ trash_stats.restored|default(0) }}</div>
                    <div class="badge-label">{{ t('trash.restored')|default('Wiederhergestellt') }}</div>
                </div>
            </div>

            <div class="badge-card badge-magenta">
                <div class="badge-row">
                    <div class="badge-number">{{ trash_stats.purged|default(0) }}</div>
                    <div class="badge-label">{{ t('trash.purged')|default('Endgultig entfernt') }}</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card" style="margin-bottom:1rem;">
    <div class="card-body">
        <form method="get" action="/admin/trash" class="form-grid"
            style="display:grid;grid-template-columns:repeat(5,minmax(140px,1fr));gap:0.75rem;">
            <div>
                <select class="form-control" name="status">
                    <option value="trashed" {{ trash_filters.status=='trashed' ? 'selected' : '' }}>{{
                        t('trash.status_trashed')|default('Im Papierkorb') }}</option>
                    <option value="restored" {{ trash_filters.status=='restored' ? 'selected' : '' }}>{{
                        t('trash.status_restored')|default('Wiederhergestellt') }}</option>
                    <option value="purged" {{ trash_filters.status=='purged' ? 'selected' : '' }}>{{
                        t('trash.status_purged')|default('Endgültig entfernt') }}</option>
                    <option value="all" {{ trash_filters.status=='all' ? 'selected' : '' }}>{{
                        t('trash.all')|default('Alle') }}</option>
                </select>
            </div>
            <div>
                <select class="form-control" name="category">
                    <option value="all" {{ trash_filters.category=='all' ? 'selected' : '' }}>{{
                        t('trash.all')|default('Alle') }}</option>
                    {% for category, count in trash_stats.categories|default({}) %}
                    <option value="{{ category }}" {{ trash_filters.category==category ? 'selected' : '' }}>{{ category
                        }} ({{ count }})</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <select class="form-control" name="entity_type">
                    <option value="all" {{ trash_filters.entity_type=='all' ? 'selected' : '' }}>{{
                        t('trash.all')|default('Alle') }}</option>
                    {% for entity_type, count in trash_stats.types|default({}) %}
                    <option value="{{ entity_type }}" {{ trash_filters.entity_type==entity_type ? 'selected' : '' }}>{{
                        entity_type }} ({{ count }})</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <select class="form-control" name="sort">
                    <option value="deleted_desc" {{ trash_filters.sort=='deleted_desc' ? 'selected' : '' }}>{{
                        t('trash.sort_deleted_desc')|default('Neueste zuerst') }}</option>
                    <option value="deleted_asc" {{ trash_filters.sort=='deleted_asc' ? 'selected' : '' }}>{{
                        t('trash.sort_deleted_asc')|default('Älteste zuerst') }}</option>
                    <option value="name_asc" {{ trash_filters.sort=='name_asc' ? 'selected' : '' }}>{{
                        t('trash.sort_name_asc')|default('Name A-Z') }}</option>
                    <option value="name_desc" {{ trash_filters.sort=='name_desc' ? 'selected' : '' }}>{{
                        t('trash.sort_name_desc')|default('Name Z-A') }}</option>
                </select>
            </div>
            <div class="filter-actions" style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.75rem; align-items:end;">
                <div>
                    <input class="form-control" type="text" name="q" value="{{ trash_filters.q|default('') }}"
                        placeholder="{{ t('trash.search_placeholder')|default('Key, Name, Typ ...') }}">
                </div>
                <div class="filter-actions-right" style="text-align: right;">
                    <button type="submit" class="btn btn-primary">{{ t('trash.filter_apply')|default('Filtern') }}</button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-body" style="overflow:auto;">
        <table class="table" style="margin:0;">
            <thead>
                <tr>
                    <th>{{ t('trash.when')|default('Geloscht am') }}</th>
                    <th>{{ t('trash.category')|default('Kategorie') }}</th>
                    <th>{{ t('trash.type')|default('Typ') }}</th>
                    <th>{{ t('trash.name')|default('Name') }}</th>
                    <th>{{ t('trash.key')|default('Key') }}</th>
                    <th>{{ t('trash.status')|default('Status') }}</th>
                    <th style="text-align:right;">{{ t('trash.actions')|default('Aktionen') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in trash_items %}
                {% set payload = item.payload|default({}) %}
                {% set itemName = payload.name|default(payload.title|default(payload.username|default(item.entity_key))) %}
                {% set actorName = '' %}
                {% if item.deleted_by is not empty %}
                    {% set actorName = trash_actors[item.deleted_by]|default('') %}
                {% endif %}

                {# Determine display category and type #}
                {% set displayCategory = '' %}
                {% set displayType = '' %}
                {% if item.category == 'content' %}
                    {% set contentType = payload.type|default(item.entity_type) %}
                    {% set displayCategory = {
                        'article':'Artikel', 'page':'Seite', 'snippet':'Snippet', 'documentation':'Doku'
                    }[contentType] | default(contentType|capitalize) %}
                    {% if payload.entry is defined and payload.entry.id is defined %}
                        {% set displayType = contentType ~ ' #' ~ payload.entry.id %}
                    {% else %}
                        {% set displayType = contentType %}
                    {% endif %}
                {% elseif item.category == 'users' %}
                    {% set displayCategory = 'Benutzer' %}
                    {% set displayType = item.entity_type %}
                {% elseif item.category == 'access' %}
                    {% set displayCategory = 'Zugriff / Rolle' %}
                    {% set displayType = item.entity_type %}
                {% elseif item.category == 'themes' %}
                    {% set displayCategory = 'Theme' %}
                    {% set displayType = payload.id|default(item.entity_key) %}
                {% else %}
                    {% set displayCategory = item.category|capitalize %}
                    {% set displayType = item.entity_type %}
                {% endif %}
                <tr>
                    <td>{{ item.deleted_at|default('-') }}</td>
                    <td><span class="badge badge-draft">{{ displayCategory }}</span></td>
                    <td>{{ displayType }}</td>
                    <td>{{ actorName ?: itemName }}</td>
                    <td><code>{{ item.entity_key }}</code></td>
                    <td>
                        {% if item.status == 'trashed' %}
                        <span class="badge badge-pending">{{ t('trash.status_trashed_short')|default('Trashed')
                            }}</span>
                        {% elseif item.status == 'restored' %}
                        <span class="badge badge-published">{{ t('trash.status_restored_short')|default('Restored')
                            }}</span>
                        {% else %}
                        <span class="badge badge-draft">{{ t('trash.status_purged_short')|default('Purged') }}</span>
                        {% endif %}
                    </td>
                    <td style="text-align:right;white-space:nowrap;">
                        {% if can_manage_trash and item.status == 'trashed' %}
                        <form action="{{ route('admin.trash.restore', {'id': item.id}) }}" method="post"
                            style="display:inline-block">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <button type="submit" class="btn btn-sm btn-primary" aria-label="{{ t('trash.restore')|default('Wiederherstellen') }}"
                                data-confirm="{{ t('trash.confirm_restore')|default('Eintrag wirklich wiederherstellen?') }}">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M21 12a9 9 0 10-2.6 6.1L21 12z" fill="currentColor" opacity="0.15" />
                                    <path d="M21 12a9 9 0 10-2.6 6.1L21 12z" stroke="currentColor" stroke-width="0" />
                                    <path d="M3 12v4a1 1 0 001 1h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M21 12a9 9 0 10-2.6 6.1L21 12z" stroke="currentColor" stroke-width="0"/>
                                    <path d="M7 7l-4 4 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </form>
                        {% else %}
                        <button type="button" class="btn btn-sm btn-primary" aria-label="{{ t('trash.restore')|default('Wiederherstellen') }}" disabled>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M21 12a9 9 0 10-2.6 6.1L21 12z" fill="currentColor" opacity="0.15" />
                                <path d="M3 12v4a1 1 0 001 1h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M7 7l-4 4 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        {% endif %}

                        {% if can_manage_trash %}
                        <form action="{{ route('admin.trash.purge', {'id': item.id}) }}" method="post"
                            style="display:inline-block">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <button type="submit" class="btn btn-sm btn-danger" aria-label="{{ t('trash.purge')|default('Endgultig entfernen') }}" data-confirm-double="1"
                                data-confirm="{{ t('trash.confirm_purge_step1')|default('Eintrag endgultig entfernen?') }}"
                                data-confirm-second="{{ t('trash.confirm_purge_step2')|default('Diese Aktion kann nicht ruckgangig gemacht werden.') }}">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M8 6V4h8v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M10 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M14 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </form>
                        {% else %}
                        <button type="button" class="btn btn-sm btn-danger" aria-label="{{ t('trash.purge')|default('Endgultig entfernen') }}" disabled>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M8 6V4h8v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M10 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        {% endif %}
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-muted" style="padding:1rem;">{{ t('trash.empty')|default('Keine Eintrage
                        im Papierkorb.') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}