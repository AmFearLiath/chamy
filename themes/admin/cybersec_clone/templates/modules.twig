{% extends 'base.twig' %}

{% block title %}{{ t('admin.modules')|default('Module') }} – Chamy CMS{% endblock %}

{% block breadcrumb %}
    <a href="/admin">{{ t('admin.dashboard')|default('Dashboard') }}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{{ t('admin.modules')|default('Module') }}</span>
{% endblock %}

{% block content %}
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">{{ t('admin.modules')|default('Module') }}</h1>
        <span class="page-badge">{{ t('modules.dashboard')|default('Dashboard') }}</span>
    </div>
    <div class="page-header-right">
        <a href="/admin/modules/manager" class="btn btn-secondary">{{ t('modules.manager_tab')|default('Manager') }}</a>
        <a href="/admin/modules/marketplace" class="btn btn-primary">{{ t('modules.marketplace_tab')|default('Marketplace') }}</a>
        <a href="/admin/modules/sdk" class="btn btn-ghost">{{ t('modules.sdk_tab')|default('SDK') }}</a>
        <a href="/admin/modules/config" class="btn btn-ghost">{{ t('modules.config_tab')|default('Konfiguration') }}</a>
    </div>
</div>

{% if not can_manage_modules %}
<div class="alert alert-warning" style="margin-bottom: 1rem;">
    {{ t('modules.read_only_hint')|default('Lesemodus: Ohne Berechtigung können Module angesehen, aber nicht verändert werden.') }}
</div>
{% endif %}

{# ── Stats ── #}
<div class="theme-stats-grid mod-stats-grid">
    <div class="stat-card">
        <div class="stat-label">{{ t('modules.stat_installed')|default('Installierte Module') }}</div>
        <div class="stat-value stat-value-multi">
            <div class="stat-number">{{ mod_stats.installed }}</div>
            <div class="stat-meta">{{ t('modules.stat_active')|default('Aktiv') }}: <strong>{{ mod_stats.active }}</strong><br>{{ t('modules.stat_inactive')|default('Inaktiv') }}: {{ mod_stats.inactive }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">{{ t('modules.stat_marketplace')|default('Marketplace Module') }}</div>
        <div class="stat-value stat-value-multi">
            <div class="stat-number">{{ mod_stats.marketplace_total }}</div>
            <div class="stat-meta">{{ t('modules.free')|default('Kostenlos') }}: {{ mod_stats.marketplace_free }}<br>{{ t('modules.paid')|default('Bezahlt') }}: {{ mod_stats.marketplace_paid }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">{{ t('modules.stat_categories')|default('Kategorien') }}</div>
        <div class="stat-value stat-value-multi">
            <div class="stat-number">{{ marketplace.categories|length }}</div>
            <div class="stat-meta">{{ t('modules.stat_categories_hint')|default('Verfügbare Mod-Kategorien im Marketplace') }}</div>
        </div>
    </div>
</div>

{# ── Main Two-Column Grid ── #}
<div class="theme-dashboard-grid">
    {# Installed Modules #}
    <section class="card">
        <div class="card-header">
            <h3 class="card-title">{{ t('modules.installed_title')|default('Installierte Module') }}</h3>
            <a href="/admin/modules/manager" class="btn btn-sm btn-ghost">{{ t('modules.all_details')|default('Alle verwalten') }}</a>
        </div>
        <div class="card-body">
            <div class="theme-list-compact">
                {% for id, mod in modules|slice(0, 5) %}
                <article class="theme-row">
                    <div class="mod-icon-block" style="--preview: {{ mod.preview_color|default('#4d7aff') }}">
                        <span class="mod-icon">⧉</span>
                    </div>
                    <div>
                        <strong>{{ mod.name|default(id) }}</strong>
                        <div class="text-muted">v{{ mod.version|default('?') }} · {{ mod.author|default('Unbekannt') }}</div>
                    </div>
                    <div class="theme-row-actions">
                        <span class="badge {{ active[id] is defined ? 'badge-published' : 'badge-draft' }}">{{ active[id] is defined ? t('modules.active')|default('Aktiv') : t('modules.inactive')|default('Inaktiv') }}</span>
                        <a href="/admin/modules/manager/{{ id }}" class="btn btn-sm btn-secondary">{{ t('modules.details')|default('Details') }}</a>
                    </div>
                </article>
                {% else %}
                <div class="text-muted" style="padding:.5rem 0;">{{ t('modules.no_installed')|default('Keine Module installiert.') }}</div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# Marketplace Preview #}
    <section class="card">
        <div class="card-header">
            <h3 class="card-title">{{ t('modules.marketplace_title')|default('Mod-Marktplatz') }}</h3>
            <a href="/admin/modules/marketplace" class="btn btn-sm btn-ghost">{{ t('modules.browse_all')|default('Alle durchsuchen') }}</a>
        </div>
        <div class="card-body">
            <div class="theme-list-compact">
                {% for item in marketplace.items|slice(0, 5) %}
                <article class="theme-row">
                    <div class="mod-icon-block" style="--preview: {{ item.preview_color|default('#4d7aff') }}">
                        <span class="mod-icon">◆</span>
                    </div>
                    <div>
                        <strong>{{ item.name }}</strong>
                        <div class="text-muted">{{ category_labels[item.category]|default(item.category|capitalize) }} · {{ item.pricing == 'free' ? t('modules.free')|default('Kostenlos') : item.price ~ ' ' ~ item.currency }}</div>
                    </div>
                    <div class="theme-row-actions">
                        <span class="text-muted">★ {{ item.rating }} · ↓ {{ item.downloads }}</span>
                        <a href="/admin/modules/marketplace/{{ item.id }}" class="btn btn-sm btn-secondary">{{ t('modules.preview')|default('Vorschau') }}</a>
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>
</div>

{# ── Sub-Navigation Cards ── #}
<div class="theme-subnav-grid mod-subnav-grid">
    <a href="/admin/modules/manager" class="theme-subnav-card">
        <h4>{{ t('modules.subnav_manager_title')|default('Mod-Manager') }}</h4>
        <p>{{ t('modules.subnav_manager_text')|default('Installierte Module aktivieren, deaktivieren, konfigurieren und deinstallieren.') }}</p>
        <span class="theme-subnav-link">{{ t('modules.open_subpage')|default('Unterseite öffnen') }}</span>
    </a>
    <a href="/admin/modules/marketplace" class="theme-subnav-card">
        <h4>{{ t('modules.subnav_marketplace_title')|default('Marketplace durchsuchen') }}</h4>
        <p>{{ t('modules.subnav_marketplace_text')|default('Neue Module finden, filtern und installieren – kostenlos und Premium.') }}</p>
        <span class="theme-subnav-link">{{ t('modules.open_subpage')|default('Unterseite öffnen') }}</span>
    </a>
    <a href="/admin/modules/sdk" class="theme-subnav-card">
        <h4>{{ t('modules.subnav_sdk_title')|default('Entwickler SDK') }}</h4>
        <p>{{ t('modules.subnav_sdk_text')|default('Dokumentation, API-Referenz und Vorlagen für die Modul-Entwicklung.') }}</p>
        <span class="theme-subnav-link">{{ t('modules.open_subpage')|default('Unterseite öffnen') }}</span>
    </a>
    <a href="/admin/modules/config" class="theme-subnav-card">
        <h4>{{ t('modules.subnav_config_title')|default('Konfiguration') }}</h4>
        <p>{{ t('modules.subnav_config_text')|default('Globale Modul-Einstellungen, Marketplace-Optionen und Sandbox-Modus.') }}</p>
        <span class="theme-subnav-link">{{ t('modules.open_subpage')|default('Unterseite öffnen') }}</span>
    </a>
</div>

{# ── Category Overview ── #}
{% if marketplace.categories|length > 0 %}
<div class="card" style="margin-top:1.25rem;">
    <div class="card-header">
        <h3 class="card-title">{{ t('modules.category_overview')|default('Kategorien im Überblick') }}</h3>
    </div>
    <div class="card-body">
        <div class="mod-category-chips">
            {% for cat, count in marketplace.categories %}
            <a href="/admin/modules/marketplace?category={{ cat }}" class="mod-category-chip">
                <span class="mod-category-chip-name">{{ category_labels[cat]|default(cat|capitalize) }}</span>
                <span class="mod-category-chip-count">{{ count }}</span>
            </a>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
