{% extends 'base.twig' %}

{% block title %}{{ mod.name }} – {{ t('modules.marketplace_tab')|default('Marketplace') }} – Chamy CMS{% endblock %}

{% block breadcrumb %}
    <a href="/admin">{{ t('admin.dashboard')|default('Dashboard') }}</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/admin/modules">{{ t('admin.modules')|default('Module') }}</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/admin/modules/marketplace">{{ t('modules.marketplace_tab')|default('Marketplace') }}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{{ mod.name }}</span>
{% endblock %}

{% block content %}
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">{{ mod.name }}</h1>
        <span class="page-badge">{{ category_labels[mod.category]|default(mod.category|capitalize) }}</span>
    </div>
    <div class="page-header-right">
        <a href="/admin/modules/marketplace" class="btn btn-ghost">{{ t('modules.back_to_marketplace')|default('Zurück zum Marketplace') }}</a>
        {% if is_installed %}
        <a href="/admin/modules/manager/{{ mod.id }}" class="btn btn-secondary">{{ t('modules.go_to_manager')|default('Im Manager öffnen') }}</a>
        {% else %}
        <button class="btn btn-primary" {{ not can_manage_modules ? 'disabled' : '' }}>{{ t('modules.install')|default('Installieren') }}</button>
        {% endif %}
    </div>
</div>

<div class="mod-detail-layout">
    {# ── Hero Preview ── #}
    <section class="card">
        <div class="theme-detail-preview preview-swatch-{{ (mod.id|length % 6) + 1 }}" style="min-height:260px;">
            <div>
                <strong style="font-size:1.5rem;">{{ mod.name }}</strong>
                <p style="margin:.5rem 0 0; opacity:.85;">{{ mod.description }}</p>
            </div>
        </div>
        <div class="card-body">
            <div class="theme-meta-line" style="margin-bottom:1rem;">
                <span class="badge {{ mod.pricing == 'free' ? 'badge-published' : 'badge-review' }}">{{ mod.pricing == 'free' ? t('modules.free')|default('Kostenlos') : mod.price ~ ' ' ~ mod.currency }}</span>
                <span class="badge {{ is_installed ? 'badge-published' : 'badge-draft' }}">{{ is_installed ? t('modules.installed')|default('Installiert') : t('modules.not_installed')|default('Nicht installiert') }}</span>
                <span class="text-muted">v{{ mod.version }}</span>
                <span class="text-muted">{{ t('modules.updated')|default('Aktualisiert') }}: {{ mod.updated_at }}</span>
            </div>

            <h3 style="margin-bottom:.5rem;">{{ t('modules.features')|default('Funktionen') }}</h3>
            <div class="mod-feature-grid">
                {% for feature in mod.features %}
                <div class="mod-feature-item">
                    <span class="mod-feature-icon">✓</span>
                    <span>{{ feature }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ── Sidebar Info ── #}
    <aside class="mod-detail-sidebar">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ t('modules.info')|default('Informationen') }}</h3>
            </div>
            <div class="card-body">
                <dl class="mod-info-list">
                    <dt>{{ t('modules.author')|default('Autor') }}</dt>
                    <dd>{{ mod.author }}</dd>

                    <dt>{{ t('modules.version')|default('Version') }}</dt>
                    <dd>v{{ mod.version }}</dd>

                    <dt>{{ t('modules.category')|default('Kategorie') }}</dt>
                    <dd>{{ category_labels[mod.category]|default(mod.category|capitalize) }}</dd>

                    <dt>{{ t('modules.downloads')|default('Downloads') }}</dt>
                    <dd>{{ mod.downloads|number_format(0, ',', '.') }}</dd>

                    <dt>{{ t('modules.rating')|default('Bewertung') }}</dt>
                    <dd>
                        <span class="mod-rating">
                            {% for i in 1..5 %}
                                <span class="mod-star {{ i <= mod.rating|round ? 'mod-star-filled' : '' }}">★</span>
                            {% endfor %}
                            <span class="text-muted">({{ mod.rating }})</span>
                        </span>
                    </dd>

                    <dt>{{ t('modules.pricing')|default('Preis') }}</dt>
                    <dd>{{ mod.pricing == 'free' ? t('modules.free')|default('Kostenlos') : mod.price ~ ' ' ~ mod.currency }}</dd>

                    <dt>{{ t('modules.updated')|default('Aktualisiert') }}</dt>
                    <dd>{{ mod.updated_at }}</dd>
                </dl>
            </div>
        </div>

        <div class="card" style="margin-top:1rem;">
            <div class="card-header">
                <h3 class="card-title">{{ t('modules.requirements')|default('Voraussetzungen') }}</h3>
            </div>
            <div class="card-body">
                {% if mod.requires is defined and mod.requires is iterable %}
                <ul class="mod-requirements-list">
                    {% for pkg, ver in mod.requires %}
                    <li><code>{{ pkg }}</code> <span class="text-muted">{{ ver }}</span></li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="text-muted">{{ t('modules.no_requirements')|default('Keine besonderen Voraussetzungen.') }}</p>
                {% endif %}
            </div>
        </div>

        <div class="card" style="margin-top:1rem;">
            <div class="card-header">
                <h3 class="card-title">{{ t('modules.tags')|default('Tags') }}</h3>
            </div>
            <div class="card-body">
                <div class="theme-tag-list">
                    {% for tag in mod.tags %}
                    <a href="/admin/modules/marketplace?q={{ tag }}" class="mod-tag-link">{{ tag }}</a>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="mod-detail-actions" style="margin-top:1rem;">
            {% if is_installed %}
            <a href="/admin/modules/manager/{{ mod.id }}" class="btn btn-secondary btn-block">{{ t('modules.go_to_manager')|default('Im Manager öffnen') }}</a>
            {% else %}
            <button class="btn btn-primary btn-block" {{ not can_manage_modules ? 'disabled' : '' }}>{{ t('modules.install')|default('Installieren') }}</button>
            {% endif %}
        </div>
    </aside>
</div>
{% endblock %}
