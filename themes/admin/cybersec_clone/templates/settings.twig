                                        <div class="text-muted">Assets: {{ fonts_analysis.asset_count|default(0) }}</div>
                                        {% if fonts_analysis.families|default([]) is not empty %}
                                        <div class="text-muted">{{ t('admin.settings_assets_font_family')|default('Familien') }}: {{ fonts_analysis.families|join(', ') }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header"><strong>{{ t('admin.settings_assets_import')|default('Import') }} / {{ t('admin.settings_assets_export')|default('Export') }}</strong></div>
                            <div class="card-body" style="display:grid;gap:8px;">
                                <form method="post" action="/admin/settings" style="display:grid;gap:8px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="asset_action" value="fonts.import">
                                    <textarea class="form-control" name="import_json" rows="6" placeholder="{{ t('admin.settings_assets_import_json')|default('Import-JSON') }}" {{ not can_manage_fonts ? 'disabled' : '' }}></textarea>
                                    <button type="submit" class="btn btn-primary" {{ not can_manage_fonts ? 'disabled' : '' }}>{{ t('admin.settings_assets_import')|default('Import') }}</button>
                                </form>
                                <textarea class="form-control" rows="6" readonly>{{ asset_export_type == 'fonts' ? asset_export_payload|default('') : '' }}</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var familyInput = document.getElementById('fontPreviewFamily');
            var textInput = document.getElementById('fontPreviewText');
            var sizeInput = document.getElementById('fontPreviewSize');
            var previewBox = document.getElementById('fontPreviewBox');
            var previewMeta = document.getElementById('fontPreviewMeta');

            function renderPreview() {
                if (!previewBox) return;
                var family = (familyInput && familyInput.value ? familyInput.value : 'Inter').trim();
                var text = textInput && textInput.value ? textInput.value : 'Sphinx of black quartz, judge my vow. 0123456789';
                var size = sizeInput && sizeInput.value ? parseInt(sizeInput.value, 10) : 32;
                if (Number.isNaN(size) || size < 12) size = 12;
                if (size > 72) size = 72;

                previewBox.style.fontFamily = "'" + family + "', sans-serif";
                previewBox.style.fontSize = size + 'px';
                previewBox.textContent = text;
            }

            document.addEventListener('click', function (e) {
                var trigger = e.target.closest('[data-font-preview]');
                if (!trigger) return;
                var css = trigger.getAttribute('data-font-css') || '';
                var family = trigger.getAttribute('data-font-family') || '';
                if (css && window.ChamyFontLoader && typeof window.ChamyFontLoader.load === 'function') {
                    window.ChamyFontLoader.load(css);
                }
                if (familyInput && family) {
                    familyInput.value = family;
                }
                if (previewMeta) {
                    previewMeta.textContent = css;
                }
                renderPreview();
            });

            [familyInput, textInput, sizeInput].forEach(function (el) {
                if (!el) return;
                el.addEventListener('input', renderPreview);
                el.addEventListener('change', renderPreview);
            });

            renderPreview();
        })();
    </script>

    {% for group_name, group_settings in settings %}
    <div id="tab-settings-{{ group_name|lower|replace({' ':'-'}) }}" class="tab-panel {{ asset_active_tab == '' and loop.first ? 'active' : '' }}">
        <form method="post" action="/admin/settings">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header">
                    <h3 style="margin: 0; text-transform: capitalize;">{{ group_name }}</h3>
                </div>
                <div class="card-body">
                    <div class="settings-grid">
                        {% for key, setting in group_settings %}
                        <div class="form-group settings-item">
                            <label class="form-label" for="setting_{{ setting.id }}">{{ setting.key }}</label>
                            {% if setting.type == 'boolean' %}
                            <select name="settings[{{ setting.id }}]" id="setting_{{ setting.id }}" class="form-control" {{ not can_manage_settings ? 'disabled' : '' }}>
                                <option value="1" {{ setting.value == '1' ? 'selected' : '' }}>{{ t('admin.yes')|default('Ja') }}</option>
                                <option value="0" {{ setting.value == '0' ? 'selected' : '' }}>{{ t('admin.no')|default('Nein') }}</option>
                            </select>
                            {% elseif setting.type == 'integer' %}
                            <input type="number" name="settings[{{ setting.id }}]" id="setting_{{ setting.id }}" class="form-control" value="{{ setting.value }}" {{ not can_manage_settings ? 'disabled' : '' }}>
                            {% else %}
                            <input type="text" name="settings[{{ setting.id }}]" id="setting_{{ setting.id }}" class="form-control" value="{{ setting.value }}" {{ not can_manage_settings ? 'disabled' : '' }}>
                            {% endif %}
                            <small class="form-hint text-muted">{{ group_name }}.{{ setting.key }} ({{ setting.type }})</small>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div style="text-align: right;">
                <button type="submit" class="btn btn-primary" {{ not can_manage_settings ? 'disabled' : '' }}>{{ t('admin.save_settings')|default('Einstellungen speichern') }}</button>
            </div>
        </form>
    </div>
    {% endfor %}
</div>
{% endblock %}
