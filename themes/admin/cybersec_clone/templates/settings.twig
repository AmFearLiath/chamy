{% extends 'base.twig' %}

{% block title %}{{ t('admin.settings')|default('Einstellungen') }} – Chamy CMS{% endblock %}

{% block breadcrumb %}
    <a href="/admin">Dashboard</a>
    <span class="breadcrumb-sep">›</span>
    <span>{{ t('admin.settings')|default('Einstellungen') }}</span>
{% endblock %}

{% block content %}
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-title">{{ t('admin.settings')|default('Einstellungen') }}</h1>
    </div>
</div>

{% if not can_manage_settings %}
<div class="alert alert-warning" style="margin-bottom: 1rem;">
    {{ t('admin.read_only_settings_hint')|default('Sie haben nur Leserechte. Änderungen können angesehen, aber nicht gespeichert werden.') }}
</div>
{% endif %}

{% set has_settings = settings|length > 0 %}

<div class="tabs" style="margin-bottom: 1rem; overflow-x:auto; white-space:nowrap;">
    <button type="button" class="tab-btn {{ asset_active_tab == 'icons' ? 'active' : (asset_active_tab == 'fonts' ? '' : (has_settings ? 'active' : '')) }}" data-tab="icons">{{ t('admin.settings_tab_icons')|default('Icons') }}</button>
    <button type="button" class="tab-btn {{ asset_active_tab == 'fonts' ? 'active' : '' }}" data-tab="fonts">{{ t('admin.settings_tab_fonts')|default('Schriftarten') }}</button>
    {% for group_name, group_settings in settings %}
    <button type="button" class="tab-btn {{ asset_active_tab == '' and loop.first ? 'active' : '' }}" data-tab="settings-{{ group_name|lower|replace({' ':'-'}) }}">{{ group_name|capitalize }}</button>
    {% endfor %}
</div>

<div class="tab-panels">
    <div id="tab-icons" class="tab-panel {{ asset_active_tab == 'icons' ? 'active' : (asset_active_tab == 'fonts' ? '' : (has_settings ? '' : 'active')) }}">
        {% set tpl_result = icons_template_result is iterable ? icons_template_result : {} %}
        {% set tpl_ok = tpl_result.success|default(false) %}
        <div class="card" style="margin-bottom: 1rem;">
            <div class="card-header">
                <h3 style="margin:0;">{{ t('admin.settings_icons_title')|default('Icon-Manager') }}</h3>
            </div>
            <div class="card-body">
                <p class="text-muted" style="margin-bottom:1rem;">{{ t('admin.settings_icons_desc')|default('Icon-Fonts analysieren, lokal installieren und als Sets verwalten.') }}</p>
                {% if not can_manage_icons %}
                <div class="alert alert-warning" style="margin-bottom:1rem;">{{ t('admin.settings_assets_readonly')|default('Nur Leserechte für diesen Manager.') }}</div>
                {% endif %}

                <div class="card" style="margin-bottom:1rem;">
                    <div class="card-header"><strong>{{ t('admin.settings_assets_icon_sets')|default('Icon-Sets') }}</strong></div>
                    <div class="card-body" style="overflow:auto;">
                        <table class="table" style="margin:0;">
                            <thead>
                                <tr>
                                    <th>{{ t('admin.settings_assets_name')|default('Name') }}</th>
                                    <th>{{ t('admin.settings_assets_id')|default('ID') }}</th>
                                    <th>CSS</th>
                                    <th>{{ t('admin.settings_assets_areas')|default('Bereiche') }}</th>
                                    <th>{{ t('admin.settings_assets_scope')|default('Freigabe für') }}</th>
                                    <th>{{ t('admin.settings_assets_status')|default('Status') }}</th>
                                    <th style="text-align:right;">{{ t('admin.settings_assets_actions')|default('Aktionen') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for set in icon_sets|default([]) %}
                                <tr>
                                    <td>{{ set.name }}</td>
                                    <td><code>{{ set.id }}</code></td>
                                    <td><code>{{ set.local_css }}</code></td>
                                    <td>{{ (set.areas|default([]))|join(', ') }}</td>
                                    <td>{{ (set.allow_for|default([]))|join(', ') }}</td>
                                    <td>{{ set.status|default('active') }}</td>
                                    <td style="text-align:right;white-space:nowrap;">
                                        <button type="button" class="btn btn-sm btn-secondary" data-open-modal="iconSourceModal" data-source-url="{{ set.source_url|default('') }}" data-source-name="{{ set.name }}" data-source-id="{{ set.id }}" data-source-package="{{ set.package|default('') }}" data-source-template="{{ set.source_template|default('') }}" data-source-version="{{ set.version|default('') }}" {{ not can_manage_icons ? 'disabled' : '' }}>{{ t('admin.settings_assets_open_analysis')|default('Details') }}</button>
                                        <a class="btn btn-sm btn-secondary" href="/admin/settings?tab=icons&export_type=icons&export_id={{ set.id }}">{{ t('admin.settings_assets_export')|default('Export') }}</a>
                                        <form method="post" action="/admin/settings" style="display:inline-block;">
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                            <input type="hidden" name="asset_action" value="icons.delete">
                                            <input type="hidden" name="set_id" value="{{ set.id }}">
                                            <button type="submit" class="btn btn-sm btn-danger" data-confirm="Set wirklich löschen?" {{ not can_manage_icons ? 'disabled' : '' }}>{{ t('admin.settings_assets_delete')|default('Löschen') }}</button>
                                        </form>
                                    </td>
                                </tr>
                                {% else %}
                                <tr><td colspan="7" class="text-muted">{{ t('admin.settings_assets_no_sets')|default('Keine Sets vorhanden.') }}</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="grid" style="grid-template-columns: 1.5fr 1fr; gap: 12px; align-items:start;">
                    <div class="card">
                        <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                            <strong>{{ t('admin.settings_assets_known_sources')|default('Bekannte Quellen') }}</strong>
                            <button type="button" class="btn btn-sm btn-primary" data-open-modal="iconSourceModal" {{ not can_manage_icons ? 'disabled' : '' }} title="{{ t('admin.settings_assets_add_source')|default('Quelle hinzufügen') }}">+</button>
                        </div>
                        <div class="card-body" style="overflow:auto;">
                            <table class="table" style="margin:0;">
                                <thead>
                                    <tr>
                                        <th>{{ t('admin.settings_assets_name')|default('Name') }}</th>
                                        <th>{{ t('admin.settings_assets_source_url')|default('Quell-URL') }}</th>
                                        <th>{{ t('admin.settings_assets_status')|default('Status') }}</th>
                                        <th style="text-align:right;">{{ t('admin.settings_assets_actions')|default('Aktionen') }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for source in icon_sources|default([]) %}
                                    {% set installed = false %}
                                    {% set installed_id = '' %}
                                    {% for s in icon_sets|default([]) %}
                                        {% if (s.source_url is defined and s.source_url == source.url) or (s.id is defined and s.id == (source.id|default(source.name|lower|replace({' ':'-'})|raw))) %}
                                            {% set installed = true %}
                                            {% set installed_id = s.id %}
                                        {% endif %}
                                    {% endfor %}
                                    <tr>
                                        <td>
                                            <strong>{{ source.name }}</strong>
                                            {% if installed %}
                                            <span class="badge badge-success" style="margin-left:8px;">{{ t('admin.installed')|default('installiert') }}</span>
                                            {% endif %}
                                        </td>
                                        <td><code>{{ source.url }}</code></td>
                                        <td>{{ installed ? t('admin.installed')|default('Installiert') : (source.status|default('known')) }}</td>
                                        <td style="text-align:right;white-space:nowrap;">
                                            {% if installed %}
                                            <button type="button" class="btn btn-sm btn-info" data-open-modal="iconSourceModal" data-update="1" data-source-url="{{ source.url }}" data-source-name="{{ source.name }}" data-source-id="{{ source.id|default('') }}" data-source-package="{{ source.package|default('') }}" data-source-template="{{ source.template_id|default('') }}" data-source-version="{{ source.latest_version|default('') }}" {{ not can_manage_icons ? 'disabled' : '' }} title="{{ t('admin.settings_assets_check_updates')|default('Auf Updates prüfen') }}">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 3v6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </button>
                                            {% else %}
                                            <form method="post" action="/admin/settings" style="display:inline-block;margin-right:6px;">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="asset_action" value="icons.install">
                                                <input type="hidden" name="set_name" value="{{ source.name }}">
                                                <input type="hidden" name="set_id" value="{{ source.id|default(source.name|lower|replace({' ':'-'})|raw) }}">
                                                <input type="hidden" name="source_url" value="{{ source.url }}">
                                                <button type="submit" class="btn btn-sm btn-success" {{ not can_manage_icons or installed ? 'disabled' : '' }} title="{{ t('admin.settings_assets_quick_install')|default('Schnell installieren') }}">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 4V14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M8 10L12 14L16 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 19H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                                </button>
                                            </form>
                                            {% endif %}
                                            <button type="button" class="btn btn-sm btn-secondary" data-open-modal="iconSourceModal" data-source-url="{{ source.url }}" data-source-name="{{ source.name }}" data-source-id="{{ source.id|default('') }}" data-source-package="{{ source.package|default('') }}" data-source-template="{{ source.template_id|default('') }}" data-source-version="{{ source.latest_version|default('') }}" {{ not can_manage_icons ? 'disabled' : '' }} title="{{ t('admin.edit')|default('Bearbeiten') }}">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 20H8L18 10L14 6L4 16V20Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 8L16 12" stroke="currentColor" stroke-width="2"/></svg>
                                            </button>
                                            {% if installed and installed_id != '' %}
                                            <form method="post" action="/admin/settings" style="display:inline-block;margin-left:6px;">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="asset_action" value="icons.install">
                                                <input type="hidden" name="set_name" value="{{ source.name }}">
                                                <input type="hidden" name="set_id" value="{{ installed_id }}">
                                                <input type="hidden" name="source_url" value="{{ source.url }}">
                                                <button type="submit" class="btn btn-sm btn-success" {{ not can_manage_icons ? 'disabled' : '' }} title="{{ t('admin.settings_assets_reinstall')|default('Neu installieren') }}">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 3v6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                </button>
                                            </form>
                                            <form method="post" action="/admin/settings" style="display:inline-block;margin-left:6px;">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="asset_action" value="icons.delete">
                                                <input type="hidden" name="set_id" value="{{ installed_id }}">
                                                <button type="submit" class="btn btn-sm btn-danger" data-confirm="Set wirklich löschen?" {{ not can_manage_icons ? 'disabled' : '' }} title="{{ t('admin.settings_assets_uninstall')|default('Deinstallieren') }}">🗑</button>
                                            </form>
                                            {% endif %}
                                            <form method="post" action="/admin/settings" style="display:inline-block;margin-left:6px;">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="asset_action" value="icons.source.delete">
                                                <input type="hidden" name="source_id" value="{{ source.id|default(source.name|lower|replace({' ':'-'})|raw) }}">
                                                <button type="submit" class="btn btn-sm btn-danger" {{ not can_manage_icons ? 'disabled' : '' }} title="{{ t('admin.delete')|default('Löschen') }}">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 7H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 7V5H15V7" stroke="currentColor" stroke-width="2"/><path d="M8 10V18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 10V18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16 10V18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    {% else %}
                                    <tr><td colspan="4" class="text-muted">{{ t('admin.settings_assets_no_sets')|default('Keine Sets vorhanden.') }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <div class="asset-side-tabs">
                                <button type="button" class="btn btn-sm btn-secondary active" data-asset-side-tab="import">{{ t('admin.settings_assets_import')|default('Import') }}</button>
                                <button type="button" class="btn btn-sm btn-secondary" data-asset-side-tab="export">{{ t('admin.settings_assets_export')|default('Export') }}</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="asset-side-panel active" data-asset-side-panel="import">
                                <form method="post" action="/admin/settings" style="display:grid;gap:8px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="asset_action" value="icons.import">
                                    <textarea class="form-control" name="import_json" rows="10" placeholder="{{ t('admin.settings_assets_import_json')|default('Import-JSON') }}" {{ not can_manage_icons ? 'disabled' : '' }}></textarea>
                                    <button type="submit" class="btn btn-primary" {{ not can_manage_icons ? 'disabled' : '' }}>{{ t('admin.settings_assets_import')|default('Import') }}</button>
                                </form>
                            </div>
                            <div class="asset-side-panel" data-asset-side-panel="export">
                                <textarea class="form-control" rows="10" readonly>{{ asset_export_type == 'icons' ? asset_export_payload|default('') : '' }}</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="iconSourceModal" class="chamy-modal" aria-hidden="true" style="display:none;">
        <div class="chamy-modal-dialog" role="dialog" aria-modal="true" style="max-width:980px; margin:0 auto;">
            <div class="chamy-modal-content">
                <div class="chamy-modal-header">
                    <h4 style="margin:0;">{{ t('admin.settings_assets_action_modal_title')|default('Analysieren / Installieren') }}</h4>
                    <button type="button" class="btn btn-sm btn-secondary" data-close-icon-modal>&times;</button>
                </div>
                <div class="chamy-modal-body" style="display:grid;grid-template-columns:1.2fr 1fr;gap:14px;">
                    <div class="card" style="margin:0;">
                        <div class="card-header"><strong>{{ t('admin.settings_assets_link_analysis')|default('Linkanalyse') }}</strong></div>
                        <div class="card-body" style="display:grid;gap:10px;">
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                                <div>
                                    <small class="text-muted">{{ t('admin.settings_assets_installed_version')|default('Installierte Version') }}</small><br>
                                    <strong id="icon-installed-version">—</strong>
                                </div>
                                <div>
                                    <small class="text-muted">{{ t('admin.settings_assets_latest_known_version')|default('Letzte bekannte Version') }}</small><br>
                                    <strong id="icon-latest-version">—</strong>
                                </div>
                            </div>

                            <label>{{ t('admin.settings_assets_template')|default('Template') }}</label>
                            <select id="icon-template-select" class="form-control" {{ not can_manage_icons ? 'disabled' : '' }}>
                                {% for template in icon_source_templates|default([]) %}
                                <option value="{{ template.id }}" {{ loop.first ? 'selected' : '' }}>{{ template.name }}</option>
                                {% endfor %}
                            </select>

                            <label>{{ t('admin.settings_assets_package')|default('Paket') }}</label>
                            <input id="icon-package-input" class="form-control" type="text" placeholder="@tabler/icons-webfont" {{ not can_manage_icons ? 'disabled' : '' }}>

                            <label>{{ t('admin.settings_assets_version_select')|default('Version wählen') }}</label>
                            <input id="icon-version-input" class="form-control" type="text" placeholder="latest oder 3.35.0" {{ not can_manage_icons ? 'disabled' : '' }}>

                            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;align-items:start;">
                                <div>
                                    <label>CSS</label>
                                    <textarea id="icon-css-list" class="form-control" rows="6" placeholder="https://cdn.jsdelivr.net/npm/{package}@{version}/dist/tabler-icons.min.css\nhttps://unpkg.com/{package}@{version}/dist/icons.css" {{ not can_manage_icons ? 'disabled' : '' }}></textarea>
                                </div>
                                <div>
                                    <label>JS</label>
                                    <textarea id="icon-js-list" class="form-control" rows="6" placeholder="https://cdn.jsdelivr.net/npm/{package}@{version}/dist/icons.min.js" {{ not can_manage_icons ? 'disabled' : '' }}></textarea>
                                </div>
                                <div>
                                    <label>Fonts</label>
                                    <textarea id="icon-font-list" class="form-control" rows="6" placeholder="https://cdn.jsdelivr.net/npm/{package}@{version}/fonts/tabler-icons.woff2" {{ not can_manage_icons ? 'disabled' : '' }}></textarea>
                                </div>
                            </div>

                            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                                <small class="text-muted">{{ t('admin.settings_assets_optional_check')|default('Optionale Prüfung, keine Voraussetzung für Installation.') }}</small>
                                <button type="button" id="icon-check-package-btn" class="btn btn-secondary" {{ not can_manage_icons ? 'disabled' : '' }}>{{ t('admin.settings_assets_check_url')|default('Verfügbarkeit prüfen') }}</button>
                            </div>
                            <div id="icon-check-results" class="asset-check-results" style="display:none;"></div>
                        </div>
                    </div>

                    <div class="card" style="margin:0;">
                        <div class="card-header"><strong>{{ t('admin.settings_assets_settings_tabs')|default('Einstellungen') }}</strong></div>
                        <div class="card-body">
                            <div class="asset-modal-tabs" style="display:flex;gap:8px;margin-bottom:10px;">
                                <button type="button" class="btn btn-sm btn-secondary active" data-modal-tab="source">{{ t('admin.settings_assets_source_tab')|default('Quelle') }}</button>
                                <button type="button" class="btn btn-sm btn-secondary" data-modal-tab="templates">{{ t('admin.settings_assets_templates_tab')|default('Templates') }}</button>
                                <button type="button" class="btn btn-sm btn-secondary" data-modal-tab="install">{{ t('admin.settings_assets_install_tab')|default('Installieren') }}</button>
                            </div>

                            <div class="asset-modal-panel active" data-modal-panel="source">
                                <form method="post" action="/admin/settings" style="display:grid;gap:8px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="asset_action" value="icons.source.add">
                                    <input type="hidden" name="source_template_id" id="icon-source-template-id">
                                    <input type="hidden" name="source_package" id="icon-source-package">
                                    <input type="hidden" name="source_latest_version" id="icon-source-latest-version">
                                    <input type="text" name="source_name" id="icon-source-name" class="form-control" placeholder="{{ t('admin.settings_assets_name')|default('Name') }}" required {{ not can_manage_icons ? 'disabled' : '' }}>
                                    <input type="text" name="source_id" id="icon-source-id" class="form-control" placeholder="{{ t('admin.settings_assets_id')|default('ID') }}" {{ not can_manage_icons ? 'disabled' : '' }}>
                                    <input type="url" name="source_url" id="icon-source-url-save" class="form-control" placeholder="{{ t('admin.settings_assets_source_url')|default('Quell-URL') }}" {{ not can_manage_icons ? 'disabled' : '' }}>
                                    <div style="text-align:right;">
                                        <button type="submit" class="btn btn-secondary" {{ not can_manage_icons ? 'disabled' : '' }}>{{ t('admin.settings_assets_save_source')|default('Quelle speichern') }}</button>
                                    </div>
                                </form>
                            </div>

                            <div class="asset-modal-panel" data-modal-panel="templates">
                                <div style="max-height:170px;overflow:auto;margin-bottom:10px;">
                                    <table class="table" style="margin:0;">
                                        <thead><tr><th>{{ t('admin.settings_assets_name')|default('Name') }}</th><th>ID</th><th></th></tr></thead>
                                        <tbody>
                                            {% for template in icon_source_templates|default([]) %}
                                            <tr>
                                                <td>{{ template.name }}</td>
                                                <td><code>{{ template.id }}</code></td>
                                                <td style="text-align:right;">
                                                    {% if template.status|default('') != 'default' %}
                                                    <form method="post" action="/admin/settings" style="display:inline-block;">
                                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                                        <input type="hidden" name="asset_action" value="icons.template.delete">
                                                        <input type="hidden" name="template_id" value="{{ template.id }}">
                                                        <button type="submit" class="btn btn-sm btn-danger" {{ not can_manage_icons ? 'disabled' : '' }}>{{ t('admin.settings_assets_delete')|default('Löschen') }}</button>
                                                    </form>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                <form method="post" action="/admin/settings" style="display:grid;gap:8px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="asset_action" value="icons.template.add">
                                    <input type="text" class="form-control" name="template_new_name" placeholder="{{ t('admin.settings_assets_template_name')|default('Template-Name') }}" required>
                                    <input type="text" class="form-control" name="template_new_id" placeholder="{{ t('admin.settings_assets_template_id')|default('Template-ID') }}" required>
                                    <select class="form-control" name="template_new_type">
                                        <option value="npm">npm</option>
                                        <option value="generic">generic</option>
                                    </select>
                                    <input type="text" class="form-control" name="template_new_url_template" placeholder="https://cdn.../{package}@{version}/{path}" required>
                                    <input type="text" class="form-control" name="template_new_versions_api" placeholder="https://registry.npmjs.org/{package}">
                                    <input type="text" class="form-control" name="template_new_default_path" placeholder="dist/icons.css">
                                    <div style="text-align:right;">
                                        <button type="submit" class="btn btn-secondary" {{ not can_manage_icons ? 'disabled' : '' }}>{{ t('admin.settings_assets_add_template')|default('Template hinzufügen') }}</button>
                                    </div>
                                </form>
                            </div>

                            <div class="asset-modal-panel" data-modal-panel="install">
                                <form id="icon-template-install-form" method="post" action="/admin/settings" style="display:grid;gap:8px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="asset_action" value="icons.template.install">
                                    <input type="hidden" name="template_id" id="icon-install-template-id">
                                    <input type="hidden" name="template_package" id="icon-install-package">
                                    <input type="hidden" name="template_version" id="icon-install-version">
                                    <input type="hidden" name="template_css_urls" id="icon-install-css">
                                    <input type="hidden" name="template_js_urls" id="icon-install-js">
                                    <input type="hidden" name="template_font_urls" id="icon-install-fonts">
                                    <input type="text" name="set_name" id="icon-set-name" class="form-control" placeholder="{{ t('admin.settings_assets_name')|default('Name') }}" required {{ not can_manage_icons ? 'disabled' : '' }}>
                                    <input type="text" name="set_id" id="icon-set-id" class="form-control" placeholder="{{ t('admin.settings_assets_id')|default('ID') }}" {{ not can_manage_icons ? 'disabled' : '' }}>
                                    <select class="form-control themed-multiselect" name="areas[]" multiple {{ not can_manage_icons ? 'disabled' : '' }}>
                                        <option value="admin" selected>{{ t('themes.area_admin')|default('Admin') }}</option>
                                        <option value="frontend" selected>{{ t('themes.area_frontend')|default('Frontend') }}</option>
                                    </select>
                                    <select class="form-control themed-multiselect" name="allow_for[]" multiple {{ not can_manage_icons ? 'disabled' : '' }}>
