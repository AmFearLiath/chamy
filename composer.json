{
    "name": "chamy/cms",
    "description": "Chamy – Modular Content Management System",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "twig/twig": "^3.8",
        "vlucas/phpdotenv": "^5.6",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Chamy\\Core\\": "core/",
            "Chamy\\Modules\\": "modules/",
            "Chamy\\Themes\\": "themes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chamy\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
